# Auth.js / NextAuth — لا ترفع القيم الحقيقية إلى Git
# انسخ هذا الملف إلى .env.local واملأ القيم (انظر docs/platform/accounts-owner-guide-ar.md)

# مفتاح عشوائي لحماية الجلسات (ولّده مرة واحدة: openssl rand -base64 32)
AUTH_SECRET=

# Auth.js v5 — ثق بالـ Host خلف LiteSpeed/Cloudflare (Contabo)
AUTH_TRUST_HOST=true

# اختياري في Auth.js v5 — إن وُضع يجب أن يكون الأصل فقط بدون مسار وبدون خطأ إملائي:
# صحيح: https://www.arabya.org
# خطأ شائع: https:/www.arabya.org  أو  .../api/auth/callback/google
# AUTH_URL=https://www.arabya.org
# أثناء النقل إلى Render المجاني استخدم أولاً:
# AUTH_URL=https://arabya-web.onrender.com
# الدليل: docs/platform/hosting-free-render-ar.md

# من Google Cloud → Credentials → OAuth client
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# بريد Gmail للمدير (يمكن أكثر من بريد مفصول بفاصلة)
ARABYA_ADMIN_EMAILS=

# بريد إضافي لخطة عربية بلس (مفصول بفاصلة) — فوق قائمة المالك المضمّنة في الكود
# ARABYA_PLUS_EMAILS=you@example.com

# مفاتيح Pexels لبحث خلفيات الاستوديو ولفيديو الذكاء الاصطناعي عبر API (مفتاح واحد أو عدة مفصولة بفاصلة)
# PEXELS_API_KEY=key1,key2
# PEXELS_API_KEYS=key3

# مفاتيح Pixabay (منفصلة عن Pexels؛ لا تخلط المفاتيح)
# PIXABAY_API_KEY=key1,key2
# PIXABAY_API_KEYS=key3

# مزامنة بيانات الحساب (مفضّل على Contabo — SQLite محلي)
ARABYA_USER_SYNC_ENABLED=0
# ARABYA_USER_DB_PATH=/var/lib/arabya/user-data.sqlite

# Cloudflare Web Analytics (اختياري — token من لوحة Cloudflare)
# NEXT_PUBLIC_CF_BEACON_TOKEN=

# دخول اختبار محلي فقط (Playwright / وكيل). يُتجاهل دائمًا عند NODE_ENV=production
# ARABYA_E2E_AUTH=1
# ARABYA_E2E_EMAIL=e2e@arabya.local

# مزامنة D1 عبر Cloudflare Worker (legacy — لم يعد مستخدماً على Contabo)
ARABYA_D1_ENABLED=0
ARABYA_SYNC_URL=
ARABYA_SYNC_SECRET=

# لغوي — المدقق اللغوي (حصة مشروع مدقق العربية + BYOK + Auto متعدد المفاتيح)
# LUGHAWI_MONTHLY_QUOTA_CHARS=15000
# LUGHAWI_MAX_GUEST_CHARS=8000
# مفاتيح كثيرة من حسابات مختلفة (مفصولة بفاصلة):
# LUGHAWI_GOOGLE_API_KEYS=AIza1,AIza2,AIza3
# LUGHAWI_OPENAI_API_KEYS=sk-1,sk-2
# LUGHAWI_ANTHROPIC_API_KEYS=sk-ant-1,sk-ant-2
# LUGHAWI_OPENROUTER_API_KEYS=sk-or-1,sk-or-2
# LUGHAWI_GROQ_API_KEYS=gsk_1,gsk_2
# أو ملف JSON على Contabo (أفضل لـ 20–50 مفتاحًا):
# LUGHAWI_PROJECT_AI_POOL_FILE=/var/lib/arabya/lughawi-ai-pool.json
# انظر: specs/001-lughawi-proofreader/lughawi-ai-pool.example.json
# و OWNER-MULTI-KEYS-AR.md
# مجمّع نصي قديم:
# LUGHAWI_PROJECT_AI_POOL=google:AIza1|openai:sk-...
# نموذج محلي على Contabo (Ollama) — ملاذ أخير:
# LUGHAWI_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# LUGHAWI_OLLAMA_MODEL=llama3.2
# LUGHAWI_OLLAMA_API_KEY=ollama
# LUGHAWI_CREDENTIALS_SECRET=
# LUGHAWI_QUOTA_PATH=
# LUGHAWI_CREDENTIALS_PATH=

# --- Arabya NLP FastAPI (services/arabya-nlp) — Contabo localhost only ---
# ARABYA_NLP_HOST=0.0.0.0
# ARABYA_NLP_PORT=8092
# ARABYA_NLP_DATABASE_URL=sqlite:////var/lib/arabya/arabya-nlp.sqlite
# ARABYA_NLP_OLLAMA_BASE_URL=http://127.0.0.1:11434
# ARABYA_NLP_OLLAMA_MODEL=llama3.1:8b
# ARABYA_NLP_RATE_LIMIT_REQUESTS=5
# ARABYA_NLP_API_TOKENS=
# ARABYA_NLP_DEVOPS_AUTO_EXECUTE=0
# Install: bash scripts/contabo-arabya-nlp-deps.sh

# --- Sentry (تتبع الأخطاء — Contabo؛ اختياري حتى تضع DSN) ---
# أنشئ مشروع Next.js في https://sentry.io ثم الصق القيم هنا
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@o000.ingest.sentry.io/0000
# SENTRY_DSN=https://xxxx@o000.ingest.sentry.io/0000
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=arabya-web
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ENVIRONMENT=contabo
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=contabo
# بعد التعديل على Contabo: pm2 restart arabya-web --update-env
# راقب الأخطاء من: /admin/ops?tab=sentry
