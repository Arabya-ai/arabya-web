{"id":55,"slug":"ma-jain-zh","resourceId":56,"nameNative":"马坚译（中文）","nameAr":"ما جيان","nameEn":"Chinese Translation (Ma Jian)","lang":"zh","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"55:1","text":"至仁主，"},{"verseNumber":2,"verseKey":"55:2","text":"曾教授《古兰经》，"},{"verseNumber":3,"verseKey":"55:3","text":"他创造了人，"},{"verseNumber":4,"verseKey":"55:4","text":"并教人修辞。"},{"verseNumber":5,"verseKey":"55:5","text":"日月是依定数而运行的。"},{"verseNumber":6,"verseKey":"55:6","text":"草木是顺从他的意旨的。"},{"verseNumber":7,"verseKey":"55:7","text":"他曾将天升起。他曾规定公平，"},{"verseNumber":8,"verseKey":"55:8","text":"以免你们用秤不公。"},{"verseNumber":9,"verseKey":"55:9","text":"你们应当秉公地谨守衡度，你们不要使所称之物分量不足。"},{"verseNumber":10,"verseKey":"55:10","text":"他为众生而将大地放下。"},{"verseNumber":11,"verseKey":"55:11","text":"大地上有水果，和有花篦的海枣，"},{"verseNumber":12,"verseKey":"55:12","text":"与有秆的五谷和香草。"},{"verseNumber":13,"verseKey":"55:13","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":14,"verseKey":"55:14","text":"他曾用陶器般的干土创造人，"},{"verseNumber":15,"verseKey":"55:15","text":"他用火焰创造精灵。"},{"verseNumber":16,"verseKey":"55:16","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":17,"verseKey":"55:17","text":"他是两个东方的主，也是两个西方的主。"},{"verseNumber":18,"verseKey":"55:18","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":19,"verseKey":"55:19","text":"他曾任两海相交而会合，"},{"verseNumber":20,"verseKey":"55:20","text":"两海之间，有一个堤坊，两海互不侵犯。"},{"verseNumber":21,"verseKey":"55:21","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":22,"verseKey":"55:22","text":"他从两海中取出大珍珠和小珍珠。"},{"verseNumber":23,"verseKey":"55:23","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":24,"verseKey":"55:24","text":"在海中桅帆高举，状如山峦的船舶，只是他的。"},{"verseNumber":25,"verseKey":"55:25","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":26,"verseKey":"55:26","text":"凡在大地上的，都要毁灭；"},{"verseNumber":27,"verseKey":"55:27","text":"惟有你的主的本体，具有尊严与大德，将永恒存在。"},{"verseNumber":28,"verseKey":"55:28","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":29,"verseKey":"55:29","text":"凡在天地间的都仰求他；他时时都有事物。"},{"verseNumber":30,"verseKey":"55:30","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":31,"verseKey":"55:31","text":"精灵和人类啊！我将专心应付你们。"},{"verseNumber":32,"verseKey":"55:32","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":33,"verseKey":"55:33","text":"精灵和人类的群众啊！如果你们能通过天地的境界，你们就通过吧！你们必须凭据一种权柄，才能通过。"},{"verseNumber":34,"verseKey":"55:34","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":35,"verseKey":"55:35","text":"火焰和火烟将被降于你们，而你们不能自卫。"},{"verseNumber":36,"verseKey":"55:36","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":37,"verseKey":"55:37","text":"当天破离的时候，天将变成玫瑰色，好象红皮一样。"},{"verseNumber":38,"verseKey":"55:38","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":39,"verseKey":"55:39","text":"在那日，任何人和精灵都不因罪过而受审问。"},{"verseNumber":40,"verseKey":"55:40","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":41,"verseKey":"55:41","text":"犯罪者将因他们的形迹而被认识，他们的额发将被系在脚掌上。"},{"verseNumber":42,"verseKey":"55:42","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":43,"verseKey":"55:43","text":"这是犯罪者所否认的火狱。"},{"verseNumber":44,"verseKey":"55:44","text":"他们将往来于火狱和沸水之间。"},{"verseNumber":45,"verseKey":"55:45","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":46,"verseKey":"55:46","text":"凡怕站在主的御前受审问者，都得享受两座乐园。"},{"verseNumber":47,"verseKey":"55:47","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":48,"verseKey":"55:48","text":"那两座乐园，是有各种果树的。"},{"verseNumber":49,"verseKey":"55:49","text":"你们究竟否认你们的主哪一件恩典呢？"},{"verseNumber":50,"verseKey":"55:50","text":"在那两座乐园里，有两洞流行的泉源。"},{"verseNumber":51,"verseKey":"55:51","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":52,"verseKey":"55:52","text":"在那两座乐园里，每种水果，都有两样。"},{"verseNumber":53,"verseKey":"55:53","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":54,"verseKey":"55:54","text":"他们靠在用锦缎做里子的坐褥上，那两座乐园的水果，都是手所能及的。"},{"verseNumber":55,"verseKey":"55:55","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":56,"verseKey":"55:56","text":"在那些乐园中，有不视非礼的妻子，在他们的妻子之前，任何人和任何精灵都未与她们交接过。"},{"verseNumber":57,"verseKey":"55:57","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":58,"verseKey":"55:58","text":"她们好象红宝石和小珍珠一样。"},{"verseNumber":59,"verseKey":"55:59","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":60,"verseKey":"55:60","text":"行善者，只受善报。"},{"verseNumber":61,"verseKey":"55:61","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":62,"verseKey":"55:62","text":"次于那两座乐园的，还有两座乐园。"},{"verseNumber":63,"verseKey":"55:63","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":64,"verseKey":"55:64","text":"那两座乐园都是苍翠的。"},{"verseNumber":65,"verseKey":"55:65","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":66,"verseKey":"55:66","text":"在那两座乐园里，有两洞涌出的泉源。"},{"verseNumber":67,"verseKey":"55:67","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":68,"verseKey":"55:68","text":"在那两座乐园里，有水果，有海枣，有石榴。"},{"verseNumber":69,"verseKey":"55:69","text":"你们否认你们的主的哪一件恩典呢？"},{"verseNumber":70,"verseKey":"55:70","text":"在那些乐园里，有许多贤淑佳丽的女子。"},{"verseNumber":71,"verseKey":"55:71","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":72,"verseKey":"55:72","text":"他们是白皙的，是蛰居于帐幕中的。"},{"verseNumber":73,"verseKey":"55:73","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":74,"verseKey":"55:74","text":"在他们的妻子之前，任何人或精灵，都未曾与她们交接过。"},{"verseNumber":75,"verseKey":"55:75","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":76,"verseKey":"55:76","text":"他们靠在翠绿的坐褥和美丽的花毯上。"},{"verseNumber":77,"verseKey":"55:77","text":"你们究竟否认你们的主的哪一件恩典呢？"},{"verseNumber":78,"verseKey":"55:78","text":"多福哉，你具尊严和大德的主的名号！"}]}