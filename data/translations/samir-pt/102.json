{"id":102,"slug":"samir-pt","resourceId":43,"nameNative":"Samir (Português)","nameAr":"سمير","nameEn":"Portuguese Translation (Samir)","lang":"pt","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"102:1","text":"A cobiça vos entreterá,"},{"verseNumber":2,"verseKey":"102:2","text":"Até que desçais aos sepulcros."},{"verseNumber":3,"verseKey":"102:3","text":"Qual! Logo o sabereis!"},{"verseNumber":4,"verseKey":"102:4","text":"Novamente, qual! Logo o sabereis!"},{"verseNumber":5,"verseKey":"102:5","text":"Qual! Se soubésseis da ciência certa!"},{"verseNumber":6,"verseKey":"102:6","text":"Verdadeiramente, então, havíeis de ver a fogueira do inferno!"},{"verseNumber":7,"verseKey":"102:7","text":"Logo a vereis claramente."},{"verseNumber":8,"verseKey":"102:8","text":"Então, sereis interrogados, nesse dia, a respeito dos prazeres (mundanos)."}]}