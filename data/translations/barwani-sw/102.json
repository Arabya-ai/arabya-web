{"id":102,"slug":"barwani-sw","resourceId":49,"nameNative":"Ali Muhsin Al-Barwani (Kiswahili)","nameAr":"البرواني","nameEn":"Ali Muhsin Al-Barwani","lang":"sw","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"102:1","text":"Kumekushughulisheni kutafuta wingi,"},{"verseNumber":2,"verseKey":"102:2","text":"Mpaka mje makaburini!"},{"verseNumber":3,"verseKey":"102:3","text":"Sivyo hivyo! Mtakuja jua!"},{"verseNumber":4,"verseKey":"102:4","text":"Tena sivyo hivyo! Mtakuja jua!"},{"verseNumber":5,"verseKey":"102:5","text":"Sivyo hivyo! Lau mngeli jua kwa ujuzi wa yakini,"},{"verseNumber":6,"verseKey":"102:6","text":"Basi bila ya shaka mtaiona Jahannamu!"},{"verseNumber":7,"verseKey":"102:7","text":"Tena, bila ya shaka, mtaiona kwa jicho la yakini."},{"verseNumber":8,"verseKey":"102:8","text":"Tena bila ya shaka mtaulizwa siku hiyo juu ya neema."}]}