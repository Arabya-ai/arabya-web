{"id":101,"slug":"samir-pt","resourceId":43,"nameNative":"Samir (Português)","nameAr":"سمير","nameEn":"Portuguese Translation (Samir)","lang":"pt","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"101:1","text":"A calamidade!"},{"verseNumber":2,"verseKey":"101:2","text":"Que é a calamidade?"},{"verseNumber":3,"verseKey":"101:3","text":"E o que te fará entender o que é a calamidade?"},{"verseNumber":4,"verseKey":"101:4","text":"(Acontecerá) no dia em que os homens estiverem como mariposas dispersas,"},{"verseNumber":5,"verseKey":"101:5","text":"E as montanhas como lã cardada!"},{"verseNumber":6,"verseKey":"101:6","text":"Porém, quanto àqueles cujas ações pesarem na balança,"},{"verseNumber":7,"verseKey":"101:7","text":"Desfrutará de uma vida prazenteira."},{"verseNumber":8,"verseKey":"101:8","text":"Em troca, aquele cujas ações forem leves na balança,"},{"verseNumber":9,"verseKey":"101:9","text":"Terá como lar um (profundo) precipício."},{"verseNumber":10,"verseKey":"101:10","text":"E o que é que te fará entender isso?"},{"verseNumber":11,"verseKey":"101:11","text":"É o fogo ardente!"}]}