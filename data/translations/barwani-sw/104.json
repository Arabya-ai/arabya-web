{"id":104,"slug":"barwani-sw","resourceId":49,"nameNative":"Ali Muhsin Al-Barwani (Kiswahili)","nameAr":"البرواني","nameEn":"Ali Muhsin Al-Barwani","lang":"sw","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"104:1","text":"Ole wake kila safihi, msengenyaji!"},{"verseNumber":2,"verseKey":"104:2","text":"Aliye kusanya mali na kuyahisabu."},{"verseNumber":3,"verseKey":"104:3","text":"Anadhani ya kuwa mali yake yatambakisha milele!"},{"verseNumber":4,"verseKey":"104:4","text":"Hasha! Atavurumishwa katika H'ut'ama."},{"verseNumber":5,"verseKey":"104:5","text":"Na nani atakujuvya ni nini H'ut'ama?"},{"verseNumber":6,"verseKey":"104:6","text":"Moto wa Mwenyezi Mungu ulio washwa."},{"verseNumber":7,"verseKey":"104:7","text":"Ambao unapanda nyoyoni."},{"verseNumber":8,"verseKey":"104:8","text":"Hakika huo utafungiwa nao"},{"verseNumber":9,"verseKey":"104:9","text":"Kwenye nguzo zilio nyooshwa."}]}