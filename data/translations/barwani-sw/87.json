{"id":87,"slug":"barwani-sw","resourceId":49,"nameNative":"Ali Muhsin Al-Barwani (Kiswahili)","nameAr":"البرواني","nameEn":"Ali Muhsin Al-Barwani","lang":"sw","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"87:1","text":"Litakase jina la Mola wako Mlezi aliye juu kabisa,"},{"verseNumber":2,"verseKey":"87:2","text":"Aliye umba, na akaweka sawa,"},{"verseNumber":3,"verseKey":"87:3","text":"Na ambaye amekadiria na akaongoa,"},{"verseNumber":4,"verseKey":"87:4","text":"Na aliye otesha malisho,"},{"verseNumber":5,"verseKey":"87:5","text":"Kisha akayafanya makavu, meusi."},{"verseNumber":6,"verseKey":"87:6","text":"Tutakusomesha wala hutasahau,"},{"verseNumber":7,"verseKey":"87:7","text":"Ila akipenda Mwenyezi Mungu. Hakika Yeye anayajua yaliyo dhaahiri na yaliyo fichikana."},{"verseNumber":8,"verseKey":"87:8","text":"Na tutakusahilishia yawe mepesi."},{"verseNumber":9,"verseKey":"87:9","text":"Basi kumbusha, kama kukumbusha kunafaa."},{"verseNumber":10,"verseKey":"87:10","text":"Atakumbuka mwenye kuogopa."},{"verseNumber":11,"verseKey":"87:11","text":"Na atajitenga mbali nayo mpotovu,"},{"verseNumber":12,"verseKey":"87:12","text":"Ambaye atauingia Moto mkubwa."},{"verseNumber":13,"verseKey":"87:13","text":"Tena humo hatakufa wala hawi hai."},{"verseNumber":14,"verseKey":"87:14","text":"Hakika amekwisha fanikiwa aliye jitakasa."},{"verseNumber":15,"verseKey":"87:15","text":"Na akakumbuka jina la Mola wake Mlezi, na akasali."},{"verseNumber":16,"verseKey":"87:16","text":"Lakini nyinyi mnakhiari maisha ya dunia!"},{"verseNumber":17,"verseKey":"87:17","text":"Na Akhera ni bora na yenye kudumu zaidi."},{"verseNumber":18,"verseKey":"87:18","text":"Hakika haya yamo katika Vitabu vya mwanzo,"},{"verseNumber":19,"verseKey":"87:19","text":"Vitabu vya Ibrahimu na Musa."}]}