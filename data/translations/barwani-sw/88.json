{"id":88,"slug":"barwani-sw","resourceId":49,"nameNative":"Ali Muhsin Al-Barwani (Kiswahili)","nameAr":"البرواني","nameEn":"Ali Muhsin Al-Barwani","lang":"sw","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"88:1","text":"Je! Imekufikia khabari ya msiba wa kufudikiza?"},{"verseNumber":2,"verseKey":"88:2","text":"Siku hiyo nyuso zitainama,"},{"verseNumber":3,"verseKey":"88:3","text":"Zikifanya kazi, nazo taabani."},{"verseNumber":4,"verseKey":"88:4","text":"Ziingie katika Moto unao waka -"},{"verseNumber":5,"verseKey":"88:5","text":"Zikinyweshwa kutoka chemchem inayo chemka."},{"verseNumber":6,"verseKey":"88:6","text":"Hawatakuwa na chakula isipo kuwa kichungu chenye miba."},{"verseNumber":7,"verseKey":"88:7","text":"Hakinenepeshi wala hakiondoi njaa."},{"verseNumber":8,"verseKey":"88:8","text":"Siku hiyo nyuso nyengine zitakuwa kunjufu."},{"verseNumber":9,"verseKey":"88:9","text":"Zitakuwa radhi kwa juhudi yao,"},{"verseNumber":10,"verseKey":"88:10","text":"Katika Bustani ya juu."},{"verseNumber":11,"verseKey":"88:11","text":"Hawatasikia humo upuuzi."},{"verseNumber":12,"verseKey":"88:12","text":"Humo imo chemchem inayo miminika."},{"verseNumber":13,"verseKey":"88:13","text":"Humo vimo viti vilivyo nyanyuliwa,"},{"verseNumber":14,"verseKey":"88:14","text":"Na bilauri zilizo pangwa,"},{"verseNumber":15,"verseKey":"88:15","text":"Na matakia safu safu,"},{"verseNumber":16,"verseKey":"88:16","text":"Na mazulia yaliyo tandikwa."},{"verseNumber":17,"verseKey":"88:17","text":"Je! Hawamtazami ngamia jinsi alivyo umbwa?"},{"verseNumber":18,"verseKey":"88:18","text":"Na mbingu jinsi ilivyo inuliwa?"},{"verseNumber":19,"verseKey":"88:19","text":"Na milima jinsi ilivyo thibitishwa?"},{"verseNumber":20,"verseKey":"88:20","text":"Na ardhi jinsi ilivyo tandazwa?"},{"verseNumber":21,"verseKey":"88:21","text":"Basi kumbusha! Hakika wewe ni Mkumbushaji."},{"verseNumber":22,"verseKey":"88:22","text":"Wewe si mwenye kuwatawalia."},{"verseNumber":23,"verseKey":"88:23","text":"Lakini anaye rudi nyuma na kukataa,"},{"verseNumber":24,"verseKey":"88:24","text":"Basi Mwenyezi Mungu atamuadhibu kwa adhabu iliyo kubwa kabisa!"},{"verseNumber":25,"verseKey":"88:25","text":"Hakika ni kwetu Sisi ndio marejeo yao."},{"verseNumber":26,"verseKey":"88:26","text":"Kisha hakika ni juu yetu Sisi hisabu yao!"}]}