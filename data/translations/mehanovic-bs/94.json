{"id":94,"slug":"mehanovic-bs","resourceId":25,"nameNative":"Muhamed Mehanović (Bosanski)","nameAr":"مهانوفيتش","nameEn":"Muhamed Mehanović","lang":"bs","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"94:1","text":"Zar grudi tvoje nismo prostranim učinili"},{"verseNumber":2,"verseKey":"94:2","text":"i breme tvoje skinuli,"},{"verseNumber":3,"verseKey":"94:3","text":"koje je pleća tvoja pritiskalo,"},{"verseNumber":4,"verseKey":"94:4","text":"i spomen na tebe visoko uzdigli!"},{"verseNumber":5,"verseKey":"94:5","text":"Pa, zaista, s mukom je olakšanje,"},{"verseNumber":6,"verseKey":"94:6","text":"zaista, s mukom je olakšanje!"},{"verseNumber":7,"verseKey":"94:7","text":"A kad završiš, molitvi se predaj,"},{"verseNumber":8,"verseKey":"94:8","text":"i Gospodaru svome teži!"}]}