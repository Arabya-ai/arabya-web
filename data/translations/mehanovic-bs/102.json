{"id":102,"slug":"mehanovic-bs","resourceId":25,"nameNative":"Muhamed Mehanović (Bosanski)","nameAr":"مهانوفيتش","nameEn":"Muhamed Mehanović","lang":"bs","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"102:1","text":"Zaokuplja vas zgrtanje imovine"},{"verseNumber":2,"verseKey":"102:2","text":"sve dok mezarja ne posjetite."},{"verseNumber":3,"verseKey":"102:3","text":"A ne treba tako, saznat ćete svakako!"},{"verseNumber":4,"verseKey":"102:4","text":"I još jednom, ne treba tako! Saznat ćete sigurno!"},{"verseNumber":5,"verseKey":"102:5","text":"Ne valja tako, kad biste vi znali pouzdano,"},{"verseNumber":6,"verseKey":"102:6","text":"Oganj ćete, zaista, vidjeti!"},{"verseNumber":7,"verseKey":"102:7","text":"I još jednom, doista ćete ga vidjeti sasvim jasno!"},{"verseNumber":8,"verseKey":"102:8","text":"Zatim ćete Dan taj o blagodatima biti pitani sigurno!"}]}