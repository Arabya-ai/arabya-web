{"id":81,"slug":"mehanovic-bs","resourceId":25,"nameNative":"Muhamed Mehanović (Bosanski)","nameAr":"مهانوفيتش","nameEn":"Muhamed Mehanović","lang":"bs","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"81:1","text":"Kada Sunce bude skupljeno i izgubi sjaj,"},{"verseNumber":2,"verseKey":"81:2","text":"i kada zvijezde raštrkane popadaju,"},{"verseNumber":3,"verseKey":"81:3","text":"i kada planine budu pokrenute i smrvljene"},{"verseNumber":4,"verseKey":"81:4","text":"i kada steone kamile budu ostavljene"},{"verseNumber":5,"verseKey":"81:5","text":"i kada divilje životinje budu sabrane,"},{"verseNumber":6,"verseKey":"81:6","text":"i kada mora budu raspaljena"},{"verseNumber":7,"verseKey":"81:7","text":"i kada duše budu sparene,"},{"verseNumber":8,"verseKey":"81:8","text":"i kada djevojčica koja je živa zakopana bude upitana"},{"verseNumber":9,"verseKey":"81:9","text":"zbog kojeg je grijeha ubijena,"},{"verseNumber":10,"verseKey":"81:10","text":"i kada listovi budu rašireni,"},{"verseNumber":11,"verseKey":"81:11","text":"i kada nebo bude uklonjeno,"},{"verseNumber":12,"verseKey":"81:12","text":"i kada Oganj bude razbuktan,"},{"verseNumber":13,"verseKey":"81:13","text":"i kada Džennet bude približen,"},{"verseNumber":14,"verseKey":"81:14","text":"svako će saznati ono što je pripremio."},{"verseNumber":15,"verseKey":"81:15","text":"I ne! Kunem se onim što se skriva,"},{"verseNumber":16,"verseKey":"81:16","text":"što se kreće i sklanja,"},{"verseNumber":17,"verseKey":"81:17","text":"i noći kad dolazi,"},{"verseNumber":18,"verseKey":"81:18","text":"i zorom kad \"diše\","},{"verseNumber":19,"verseKey":"81:19","text":"On - Kur'an je, zaista, kazivanje Izaslanika Plemenitog,"},{"verseNumber":20,"verseKey":"81:20","text":"Moćnog, kod Gospodara Arša, cijenjenog."},{"verseNumber":21,"verseKey":"81:21","text":"Kome se drugi tamo pokoravaju, povjerljivog!"},{"verseNumber":22,"verseKey":"81:22","text":"A drug vaš nije lud:"},{"verseNumber":23,"verseKey":"81:23","text":"on ga je na obzorju jasnom vidio,"},{"verseNumber":24,"verseKey":"81:24","text":"i, kada je u pitanju ono što je čulima nedokučivo, on nije škrt,"},{"verseNumber":25,"verseKey":"81:25","text":"i on nije prokletog šejtana govor,"},{"verseNumber":26,"verseKey":"81:26","text":"pa kuda onda idete?!"},{"verseNumber":27,"verseKey":"81:27","text":"On je samo opomena svjetovima,"},{"verseNumber":28,"verseKey":"81:28","text":"onome od vas koji hoće da je na pravom putu,"},{"verseNumber":29,"verseKey":"81:29","text":"a vi ne možete ništa htjeti ako to Allah, Gospodar svjetova, neće!"}]}