{"id":1,"slug":"samir-pt","resourceId":43,"nameNative":"Samir (Português)","nameAr":"سمير","nameEn":"Portuguese Translation (Samir)","lang":"pt","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"1:1","text":"Em nome de Deus, o Clemente, o Misericordioso."},{"verseNumber":2,"verseKey":"1:2","text":"Louvado seja Deus, Senhor do Universo,"},{"verseNumber":3,"verseKey":"1:3","text":"Clemente, o Misericordioso,"},{"verseNumber":4,"verseKey":"1:4","text":"Soberano do Dia do Juízo."},{"verseNumber":5,"verseKey":"1:5","text":"Só a Ti adoramos e só de Ti imploramos ajuda!"},{"verseNumber":6,"verseKey":"1:6","text":"Guia-nos à senda reta,"},{"verseNumber":7,"verseKey":"1:7","text":"À senda dos que agraciaste, não à dos abominados, nem à dos extraviados."}]}