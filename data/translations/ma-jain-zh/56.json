{"id":56,"slug":"ma-jain-zh","resourceId":56,"nameNative":"马坚译（中文）","nameAr":"ما جيان","nameEn":"Chinese Translation (Ma Jian)","lang":"zh","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"56:1","text":"当那件大事发生的时候，"},{"verseNumber":2,"verseKey":"56:2","text":"没有任何人否认其发生。"},{"verseNumber":3,"verseKey":"56:3","text":"那件大事将是能使人降级，能使人升级的；"},{"verseNumber":4,"verseKey":"56:4","text":"当大地震荡，"},{"verseNumber":5,"verseKey":"56:5","text":"山峦粉碎，"},{"verseNumber":6,"verseKey":"56:6","text":"化为散漫的尘埃，"},{"verseNumber":7,"verseKey":"56:7","text":"而你们分为三等的时候。"},{"verseNumber":8,"verseKey":"56:8","text":"幸福者，幸福者是何等的人？"},{"verseNumber":9,"verseKey":"56:9","text":"薄命者，薄命者是何等的人？"},{"verseNumber":10,"verseKey":"56:10","text":"最先行善者，是最先入乐园的人，"},{"verseNumber":11,"verseKey":"56:11","text":"这等人，确是蒙主眷顾的。"},{"verseNumber":12,"verseKey":"56:12","text":"他们将在恩泽的乐园中。"},{"verseNumber":13,"verseKey":"56:13","text":"许多前人"},{"verseNumber":14,"verseKey":"56:14","text":"和少数后人，"},{"verseNumber":15,"verseKey":"56:15","text":"在珠宝镶成的床榻上，"},{"verseNumber":16,"verseKey":"56:16","text":"彼此相对地靠在上面。"},{"verseNumber":17,"verseKey":"56:17","text":"长生不老的僮仆，轮流着服待他们，"},{"verseNumber":18,"verseKey":"56:18","text":"捧着盏和壶，与满杯的醴泉；"},{"verseNumber":19,"verseKey":"56:19","text":"他们不因那醴泉而头痛，也不酩酊。"},{"verseNumber":20,"verseKey":"56:20","text":"他们有自己所选择的水果，"},{"verseNumber":21,"verseKey":"56:21","text":"和自己所爱好的鸟肉。"},{"verseNumber":22,"verseKey":"56:22","text":"还有白皙的、美目的妻子，"},{"verseNumber":23,"verseKey":"56:23","text":"好象藏在蚌壳里的珍珠一样。"},{"verseNumber":24,"verseKey":"56:24","text":"那是为了报酬他们的善行。"},{"verseNumber":25,"verseKey":"56:25","text":"他们在乐园里，听不到恶言和谎话，"},{"verseNumber":26,"verseKey":"56:26","text":"但听到说：祝你们平安！祝你们平安！"},{"verseNumber":27,"verseKey":"56:27","text":"幸福者，幸福者是何等的人？"},{"verseNumber":28,"verseKey":"56:28","text":"他们享受无刺的酸枣树，"},{"verseNumber":29,"verseKey":"56:29","text":"结实累累的（香蕉）树；"},{"verseNumber":30,"verseKey":"56:30","text":"漫漫的树荫；"},{"verseNumber":31,"verseKey":"56:31","text":"泛泛的流水；"},{"verseNumber":32,"verseKey":"56:32","text":"丰富的水果，"},{"verseNumber":33,"verseKey":"56:33","text":"四时不绝，可以随意摘食；"},{"verseNumber":34,"verseKey":"56:34","text":"与被升起的床榻。"},{"verseNumber":35,"verseKey":"56:35","text":"我使她们重新生长，"},{"verseNumber":36,"verseKey":"56:36","text":"我使她们常为处女，"},{"verseNumber":37,"verseKey":"56:37","text":"依恋丈夫，彼此同岁；"},{"verseNumber":38,"verseKey":"56:38","text":"这些都是幸福者所享受的。"},{"verseNumber":39,"verseKey":"56:39","text":"他们是许多前人"},{"verseNumber":40,"verseKey":"56:40","text":"和许多后人。"},{"verseNumber":41,"verseKey":"56:41","text":"薄命者，薄命者是何等的人？"},{"verseNumber":42,"verseKey":"56:42","text":"他们在毒风和沸水中，"},{"verseNumber":43,"verseKey":"56:43","text":"在黑烟的阴影下，"},{"verseNumber":44,"verseKey":"56:44","text":"既不凉爽，又不美观。"},{"verseNumber":45,"verseKey":"56:45","text":"以前他们确是豪华的，"},{"verseNumber":46,"verseKey":"56:46","text":"确是固执大罪的，"},{"verseNumber":47,"verseKey":"56:47","text":"他们常说：难道我们死后，已变成尘土和枯骨的时候，我们必定要复活吗？"},{"verseNumber":48,"verseKey":"56:48","text":"连我们的祖先也要复活吗？"},{"verseNumber":49,"verseKey":"56:49","text":"你说：前人和后人，"},{"verseNumber":50,"verseKey":"56:50","text":"在一个著名的日期和特定时间必定要被集合。"},{"verseNumber":51,"verseKey":"56:51","text":"然后迷误的、否认复活的人们啊！"},{"verseNumber":52,"verseKey":"56:52","text":"你们必定食攒（木+苦）木的果实，"},{"verseNumber":53,"verseKey":"56:53","text":"而以它充饥，"},{"verseNumber":54,"verseKey":"56:54","text":"然后痛饮沸水，"},{"verseNumber":55,"verseKey":"56:55","text":"象害消渴病的骆驼饮凉水一样。"},{"verseNumber":56,"verseKey":"56:56","text":"这是他们在报应之日所受的款待。"},{"verseNumber":57,"verseKey":"56:57","text":"我曾创造你们，你们怎么不信复活呢？"},{"verseNumber":58,"verseKey":"56:58","text":"你们告诉我吧！你们所射的精液，"},{"verseNumber":59,"verseKey":"56:59","text":"究竟是你们把它造成人呢？还是我把它造成人呢？"},{"verseNumber":60,"verseKey":"56:60","text":"我曾将死亡分配给你们，任何人不能阻挠我，"},{"verseNumber":61,"verseKey":"56:61","text":"不让我改变你们的品性，而使你们生长在你们所不知的状态中。"},{"verseNumber":62,"verseKey":"56:62","text":"你们确已知道初次的生长，你们怎不觉悟呢？"},{"verseNumber":63,"verseKey":"56:63","text":"你们告诉我吧！你们所耕种的庄稼，"},{"verseNumber":64,"verseKey":"56:64","text":"究竟是你们使它发荣呢？还是我使它发荣呢？"},{"verseNumber":65,"verseKey":"56:65","text":"假若我意欲，我必使它凋零，而你们变成诧异者，"},{"verseNumber":66,"verseKey":"56:66","text":"你们将说：我们是遭损失的。"},{"verseNumber":67,"verseKey":"56:67","text":"不然！我们是被剥夺的。"},{"verseNumber":68,"verseKey":"56:68","text":"你们告诉吧！你们所饮的水，"},{"verseNumber":69,"verseKey":"56:69","text":"究竟是你们使它从云中降下的呢？还是我使它降下的呢？"},{"verseNumber":70,"verseKey":"56:70","text":"假若我意欲，我必使它变成苦的，你们怎么不感谢呢？"},{"verseNumber":71,"verseKey":"56:71","text":"你们告诉吧！你们所钻取的火；"},{"verseNumber":72,"verseKey":"56:72","text":"究竟是你们使燧木生长的呢？还是我使它生长的呢？"},{"verseNumber":73,"verseKey":"56:73","text":"我以它为教训，并且以它为荒野的居民的慰藉，"},{"verseNumber":74,"verseKey":"56:74","text":"故你们应当颂扬你的主的大名。"},{"verseNumber":75,"verseKey":"56:75","text":"我必以星宿的没落处盟誓，"},{"verseNumber":76,"verseKey":"56:76","text":"这确是一个重大的盟誓，假若你们知道。"},{"verseNumber":77,"verseKey":"56:77","text":"这确是宝贵的《古兰经》，"},{"verseNumber":78,"verseKey":"56:78","text":"记录在珍藏的经本中，"},{"verseNumber":79,"verseKey":"56:79","text":"只有纯洁者才得抚摸那经本。"},{"verseNumber":80,"verseKey":"56:80","text":"《古兰经》是从全世界的主降示的。"},{"verseNumber":81,"verseKey":"56:81","text":"难道你们藐视这训辞，"},{"verseNumber":82,"verseKey":"56:82","text":"而以否认代替感谢吗？"},{"verseNumber":83,"verseKey":"56:83","text":"（你们）怎么不在灵魂到将死者的咽喉的时候--"},{"verseNumber":84,"verseKey":"56:84","text":"那时候，你们大家看着他，"},{"verseNumber":85,"verseKey":"56:85","text":"我比你们更临近他，但你们不晓得，"},{"verseNumber":86,"verseKey":"56:86","text":"如果你们不是受报应的，--"},{"verseNumber":87,"verseKey":"56:87","text":"你们怎不使灵魂复返于本位呢？如果你们是说实话的。"},{"verseNumber":88,"verseKey":"56:88","text":"如果他是被眷顾的，"},{"verseNumber":89,"verseKey":"56:89","text":"那末，他将享受舒适、给养与恩泽的乐园；"},{"verseNumber":90,"verseKey":"56:90","text":"如果他是幸福者，"},{"verseNumber":91,"verseKey":"56:91","text":"那末，一般幸福的人将对他说：祝你平安！"},{"verseNumber":92,"verseKey":"56:92","text":"如果他是迷误的、否认复活者，"},{"verseNumber":93,"verseKey":"56:93","text":"那末，他将享受沸水的款待，"},{"verseNumber":94,"verseKey":"56:94","text":"和烈火的烧灼。"},{"verseNumber":95,"verseKey":"56:95","text":"这确是无可置疑的真理。"},{"verseNumber":96,"verseKey":"56:96","text":"故你应当颂扬你的主的大名。"}]}