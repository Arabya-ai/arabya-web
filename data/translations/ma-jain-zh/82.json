{"id":82,"slug":"ma-jain-zh","resourceId":56,"nameNative":"马坚译（中文）","nameAr":"ما جيان","nameEn":"Chinese Translation (Ma Jian)","lang":"zh","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"82:1","text":"当穷苍破裂的时候，"},{"verseNumber":2,"verseKey":"82:2","text":"当众星飘堕的时候，"},{"verseNumber":3,"verseKey":"82:3","text":"当海洋混合的时候，"},{"verseNumber":4,"verseKey":"82:4","text":"当坟墓被揭开的时候，"},{"verseNumber":5,"verseKey":"82:5","text":"每个人都知道自己前前后后所做的一切事情。"},{"verseNumber":6,"verseKey":"82:6","text":"人啊！什么东西引诱你背离了你的仁慈的主呢？"},{"verseNumber":7,"verseKey":"82:7","text":"他曾创造了你，然后，使你健全，然后，使你均称。"},{"verseNumber":8,"verseKey":"82:8","text":"他意欲什么型式，就依什么型式而构造你。"},{"verseNumber":9,"verseKey":"82:9","text":"绝不然，但你们否认报应！"},{"verseNumber":10,"verseKey":"82:10","text":"你们的上面，确有许多监视者，"},{"verseNumber":11,"verseKey":"82:11","text":"他们是尊贵的，是记录的，"},{"verseNumber":12,"verseKey":"82:12","text":"他们知道你们的一切行为。"},{"verseNumber":13,"verseKey":"82:13","text":"善人们，必在恩泽中；"},{"verseNumber":14,"verseKey":"82:14","text":"恶人们，必在烈火中。"},{"verseNumber":15,"verseKey":"82:15","text":"他们将在报应日堕入烈火，"},{"verseNumber":16,"verseKey":"82:16","text":"他们绝不得离开它。"},{"verseNumber":17,"verseKey":"82:17","text":"你怎能知道报应日是什么？"},{"verseNumber":18,"verseKey":"82:18","text":"你怎能知道报应日是什么？"},{"verseNumber":19,"verseKey":"82:19","text":"在那日，任何人对任何人不能有什么裨益；命令全归真主。"}]}