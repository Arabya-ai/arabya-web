{"id":104,"slug":"ma-jain-zh","resourceId":56,"nameNative":"马坚译（中文）","nameAr":"ما جيان","nameEn":"Chinese Translation (Ma Jian)","lang":"zh","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"104:1","text":"伤哉！每个诽谤者, 诋毁者,"},{"verseNumber":2,"verseKey":"104:2","text":"他聚积财产, 而当作武器,"},{"verseNumber":3,"verseKey":"104:3","text":"他以为他的财产, 能使他不灭。"},{"verseNumber":4,"verseKey":"104:4","text":"绝不然, 他必定要被投在毁灭坑中。"},{"verseNumber":5,"verseKey":"104:5","text":"你怎能知道毁灭坑是什麽？"},{"verseNumber":6,"verseKey":"104:6","text":"是真主的燃著的烈活。"},{"verseNumber":7,"verseKey":"104:7","text":"能升到人的心上。"},{"verseNumber":8,"verseKey":"104:8","text":"他们必定要被关在烈火中,"},{"verseNumber":9,"verseKey":"104:9","text":"吊在许多很高的柱子上。"}]}