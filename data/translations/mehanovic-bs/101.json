{"id":101,"slug":"mehanovic-bs","resourceId":25,"nameNative":"Muhamed Mehanović (Bosanski)","nameAr":"مهانوفيتش","nameEn":"Muhamed Mehanović","lang":"bs","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"101:1","text":"Udar zastrašujući!"},{"verseNumber":2,"verseKey":"101:2","text":"Šta je Udar zastrašujući?"},{"verseNumber":3,"verseKey":"101:3","text":"I šta ti znaš šta je Udar zastrašujući?"},{"verseNumber":4,"verseKey":"101:4","text":"Dan taj ljudi će biti kao leptiri raštrkani,"},{"verseNumber":5,"verseKey":"101:5","text":"a planine kao šarena vuna iščupana."},{"verseNumber":6,"verseKey":"101:6","text":"Onaj čija dobra djela budu teška,"},{"verseNumber":7,"verseKey":"101:7","text":"u ugodnom životu će živjeti,"},{"verseNumber":8,"verseKey":"101:8","text":"a onaj čija dobra djela budu lahka,"},{"verseNumber":9,"verseKey":"101:9","text":"majka - utočište će mu bezdan biti."},{"verseNumber":10,"verseKey":"101:10","text":"A znaš li ti šta će to biti?"},{"verseNumber":11,"verseKey":"101:11","text":"Vatra užarena!"}]}