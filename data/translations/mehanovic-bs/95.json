{"id":95,"slug":"mehanovic-bs","resourceId":25,"nameNative":"Muhamed Mehanović (Bosanski)","nameAr":"مهانوفيتش","nameEn":"Muhamed Mehanović","lang":"bs","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"95:1","text":"Tako mi smokve i masline."},{"verseNumber":2,"verseKey":"95:2","text":"i Sinajske gore,"},{"verseNumber":3,"verseKey":"95:3","text":"i grada ovog, sigurnog,"},{"verseNumber":4,"verseKey":"95:4","text":"Mi čovjeka stvaramo u najljepšem obliku,"},{"verseNumber":5,"verseKey":"95:5","text":"zatim ćemo ga u najniže nizine vratiti."},{"verseNumber":6,"verseKey":"95:6","text":"samo ne one koji budu vjerovali i dobra djela činili, njima pripada nagrada neprekidna."},{"verseNumber":7,"verseKey":"95:7","text":"Pa, šta te onda navodi da poričeš obračun?"},{"verseNumber":8,"verseKey":"95:8","text":"Zar Allah nije sudija najpravedniji?!"}]}