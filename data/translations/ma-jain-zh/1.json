{"id":1,"slug":"ma-jain-zh","resourceId":56,"nameNative":"马坚译（中文）","nameAr":"ما جيان","nameEn":"Chinese Translation (Ma Jian)","lang":"zh","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"1:1","text":"奉至仁至慈的真主之名"},{"verseNumber":2,"verseKey":"1:2","text":"一切赞颂全归真主，众世界 的主，"},{"verseNumber":3,"verseKey":"1:3","text":"至仁至慈的主，"},{"verseNumber":4,"verseKey":"1:4","text":"报应日的主，"},{"verseNumber":5,"verseKey":"1:5","text":"我们只崇拜你，只求你祐助"},{"verseNumber":6,"verseKey":"1:6","text":"求你引领我们正路，"},{"verseNumber":7,"verseKey":"1:7","text":"你所祐助者的路，不是受谴怒者的路，也不是迷误者的路。"}]}