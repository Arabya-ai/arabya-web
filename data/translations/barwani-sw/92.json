{"id":92,"slug":"barwani-sw","resourceId":49,"nameNative":"Ali Muhsin Al-Barwani (Kiswahili)","nameAr":"البرواني","nameEn":"Ali Muhsin Al-Barwani","lang":"sw","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"92:1","text":"Naapa kwa usiku unapo funika!"},{"verseNumber":2,"verseKey":"92:2","text":"Na mchana unapo dhihiri!"},{"verseNumber":3,"verseKey":"92:3","text":"Na kwa Aliye umba dume na jike!"},{"verseNumber":4,"verseKey":"92:4","text":"Hakika juhudi zenu bila ya shaka ni mbali mbali."},{"verseNumber":5,"verseKey":"92:5","text":"Ama mwenye kutoa na akamchamngu,"},{"verseNumber":6,"verseKey":"92:6","text":"Na akaliwafiki lilio jema,"},{"verseNumber":7,"verseKey":"92:7","text":"Tutamsahilishia yawe mepesi."},{"verseNumber":8,"verseKey":"92:8","text":"Na ama mwenye kufanya ubakhili, na asiwe na haja ya wenzake,"},{"verseNumber":9,"verseKey":"92:9","text":"Na akakanusha lilio jema,"},{"verseNumber":10,"verseKey":"92:10","text":"Tutamsahilishia yawe mazito!"},{"verseNumber":11,"verseKey":"92:11","text":"Na mali yake yatamfaa nini atapo kuwa anadidimia?"},{"verseNumber":12,"verseKey":"92:12","text":"Hakika ni juu yetu kuonyesha uwongofu."},{"verseNumber":13,"verseKey":"92:13","text":"Na hakika ni yetu Sisi Akhera na dunia."},{"verseNumber":14,"verseKey":"92:14","text":"Basi nakuonyeni na Moto unao waka!"},{"verseNumber":15,"verseKey":"92:15","text":"Hatauingia ila mwovu kabisa!"},{"verseNumber":16,"verseKey":"92:16","text":"Anaye kadhibisha na kupa mgongo."},{"verseNumber":17,"verseKey":"92:17","text":"Na mchamngu ataepushwa nao,"},{"verseNumber":18,"verseKey":"92:18","text":"Ambaye hutoa mali yake kwa ajili ya kujitakasa."},{"verseNumber":19,"verseKey":"92:19","text":"Na wala si kwa kuwa yupo yeyote aliye mfanyia hisani ndio anamlipa."},{"verseNumber":20,"verseKey":"92:20","text":"Ila ni kutaka radhi ya Mola wake Mlezi aliye juu kabisa."},{"verseNumber":21,"verseKey":"92:21","text":"Naye atakuja ridhika!"}]}