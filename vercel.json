    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "arabyaai.com" }],
      "destination": "https://www.arabya.org/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.arabyaai.com" }],
      "destination": "https://www.arabya.org/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
