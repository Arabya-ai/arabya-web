{"id":92,"slug":"ma-jain-zh","resourceId":56,"nameNative":"马坚译（中文）","nameAr":"ما جيان","nameEn":"Chinese Translation (Ma Jian)","lang":"zh","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"92:1","text":"以笼罩时的黑夜发誓，"},{"verseNumber":2,"verseKey":"92:2","text":"以显著时的白昼发誓，"},{"verseNumber":3,"verseKey":"92:3","text":"以创造男性和女性的主发誓，"},{"verseNumber":4,"verseKey":"92:4","text":"你们的行为，确是不同的。"},{"verseNumber":5,"verseKey":"92:5","text":"至於赈济贫民，敬畏真主，"},{"verseNumber":6,"verseKey":"92:6","text":"且承认至善者，"},{"verseNumber":7,"verseKey":"92:7","text":"我将使他易於达到最易的结局。"},{"verseNumber":8,"verseKey":"92:8","text":"至於吝惜钱财，自谓无求，"},{"verseNumber":9,"verseKey":"92:9","text":"且否认至善者，"},{"verseNumber":10,"verseKey":"92:10","text":"我将使他易於达到最难的结局。"},{"verseNumber":11,"verseKey":"92:11","text":"当他沦亡的时候，他的财产於他有什麽裨益呢！"},{"verseNumber":12,"verseKey":"92:12","text":"我确有指导的责任，"},{"verseNumber":13,"verseKey":"92:13","text":"我确有後世和今世的主权。"},{"verseNumber":14,"verseKey":"92:14","text":"故我警告你们一种发焰的火，"},{"verseNumber":15,"verseKey":"92:15","text":"唯薄命者坠入其中，"},{"verseNumber":16,"verseKey":"92:16","text":"他否认真理，而背弃之。"},{"verseNumber":17,"verseKey":"92:17","text":"敬畏者，得免於火刑。"},{"verseNumber":18,"verseKey":"92:18","text":"他虔诚地施舍他的财产，"},{"verseNumber":19,"verseKey":"92:19","text":"他没有受过任何人的应报的恩德，"},{"verseNumber":20,"verseKey":"92:20","text":"但他施舍只是为了求他的至尊主的喜悦，"},{"verseNumber":21,"verseKey":"92:21","text":"他自己将来必定喜悦。"}]}