{"id":107,"slug":"samir-pt","resourceId":43,"nameNative":"Samir (Português)","nameAr":"سمير","nameEn":"Portuguese Translation (Samir)","lang":"pt","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"107:1","text":"Tens reparado em quem nega a religião?"},{"verseNumber":2,"verseKey":"107:2","text":"É quem repele o órfão,"},{"verseNumber":3,"verseKey":"107:3","text":"E não estimula (os demais) à alimentação dos necessitados."},{"verseNumber":4,"verseKey":"107:4","text":"Ai, pois, dos praticantes das orações,"},{"verseNumber":5,"verseKey":"107:5","text":"Que são negligentes em suas orações,"},{"verseNumber":6,"verseKey":"107:6","text":"Que as fazem por ostentação,"},{"verseNumber":7,"verseKey":"107:7","text":"Negando-se, contudo, a prestar obséquios!"}]}