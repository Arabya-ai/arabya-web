{"id":88,"slug":"ma-jain-zh","resourceId":56,"nameNative":"马坚译（中文）","nameAr":"ما جيان","nameEn":"Chinese Translation (Ma Jian)","lang":"zh","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"88:1","text":"大灾的消息，确已降临你了，"},{"verseNumber":2,"verseKey":"88:2","text":"在那日，将有许多人，是恭敬的、"},{"verseNumber":3,"verseKey":"88:3","text":"劳动的、辛苦的，"},{"verseNumber":4,"verseKey":"88:4","text":"他们将入烈火，"},{"verseNumber":5,"verseKey":"88:5","text":"将饮沸泉，"},{"verseNumber":6,"verseKey":"88:6","text":"他们没有食物，但有荆棘，"},{"verseNumber":7,"verseKey":"88:7","text":"既不能肥人，又不能充饥；"},{"verseNumber":8,"verseKey":"88:8","text":"在那日，将有许多人，是享福的，"},{"verseNumber":9,"verseKey":"88:9","text":"是为其劳绩而愉快的，"},{"verseNumber":10,"verseKey":"88:10","text":"他们将在崇高的乐园中，"},{"verseNumber":11,"verseKey":"88:11","text":"听不到恶言，"},{"verseNumber":12,"verseKey":"88:12","text":"里面有流泉，"},{"verseNumber":13,"verseKey":"88:13","text":"里面有高榻，"},{"verseNumber":14,"verseKey":"88:14","text":"有陈设著的杯盏，"},{"verseNumber":15,"verseKey":"88:15","text":"有排列著的靠枕，"},{"verseNumber":16,"verseKey":"88:16","text":"有铺展开的绒毯。"},{"verseNumber":17,"verseKey":"88:17","text":"难道他们不观察吗？骆驼是怎样造成的，"},{"verseNumber":18,"verseKey":"88:18","text":"天是怎样升高的，"},{"verseNumber":19,"verseKey":"88:19","text":"山峦是怎样竖起的，"},{"verseNumber":20,"verseKey":"88:20","text":"大地是怎样展开的。"},{"verseNumber":21,"verseKey":"88:21","text":"你当教诲，你只是教诲（他们的），"},{"verseNumber":22,"verseKey":"88:22","text":"你绝不是监察他们的，"},{"verseNumber":23,"verseKey":"88:23","text":"但谁转身离去而且不信道，"},{"verseNumber":24,"verseKey":"88:24","text":"真主将以最大的刑罚惩治谁。"},{"verseNumber":25,"verseKey":"88:25","text":"他们必定只归於我，"},{"verseNumber":26,"verseKey":"88:26","text":"他们的稽核，必定由我负责。"}]}