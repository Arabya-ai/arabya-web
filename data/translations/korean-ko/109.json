{"id":109,"slug":"korean-ko","resourceId":36,"nameNative":"한국어 번역","nameAr":"كوري","nameEn":"Korean","lang":"ko","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"109:1","text":"불신자들에게 일러 가로되"},{"verseNumber":2,"verseKey":"109:2","text":"너희가 숭배하는 것을 내가 숭배하지 아니하며"},{"verseNumber":3,"verseKey":"109:3","text":"내가 경배하는 분을 너희가 경배하지 아니하고"},{"verseNumber":4,"verseKey":"109:4","text":"너희가 숭배했던 것들을 내가숭배하지 아니할 것이며"},{"verseNumber":5,"verseKey":"109:5","text":"내가 경배한 그분을 너희가 경배하지 않을 것이니"},{"verseNumber":6,"verseKey":"109:6","text":"너희에게는 너희의 종교가 있고 나에게는 나의 종교가 있을 뿐이라"}]}