{"id":96,"slug":"barwani-sw","resourceId":49,"nameNative":"Ali Muhsin Al-Barwani (Kiswahili)","nameAr":"البرواني","nameEn":"Ali Muhsin Al-Barwani","lang":"sw","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"96:1","text":"Soma kwa jina la Mola wako Mlezi aliye umba,"},{"verseNumber":2,"verseKey":"96:2","text":"Amemuumba binaadamu kwa tone la damu,"},{"verseNumber":3,"verseKey":"96:3","text":"Soma! Na Mola wako Mlezi ni Karimu kushinda wote!"},{"verseNumber":4,"verseKey":"96:4","text":"Ambaye amefundisha kwa kalamu."},{"verseNumber":5,"verseKey":"96:5","text":"Kamfundisha mtu aliyo kuwa hayajui."},{"verseNumber":6,"verseKey":"96:6","text":"Kwani! Hakika mtu bila ya shaka huwa jeuri"},{"verseNumber":7,"verseKey":"96:7","text":"Akijiona katajirika."},{"verseNumber":8,"verseKey":"96:8","text":"Hakika kwa Mola wako Mlezi ndio marejeo."},{"verseNumber":9,"verseKey":"96:9","text":"Umemwona yule anaye mkataza"},{"verseNumber":10,"verseKey":"96:10","text":"Mja anapo sali?"},{"verseNumber":11,"verseKey":"96:11","text":"Umeona kama yeye yuko juu ya uwongofu?"},{"verseNumber":12,"verseKey":"96:12","text":"Au anaamrisha uchamngu?"},{"verseNumber":13,"verseKey":"96:13","text":"Umeona kama yeye akikanusha na anarudi nyuma?"},{"verseNumber":14,"verseKey":"96:14","text":"Hajui ya kwamba Mwenyezi Mungu anaona?"},{"verseNumber":15,"verseKey":"96:15","text":"Kwani! Kama haachi, tutamkokota kwa shungi la nywele!"},{"verseNumber":16,"verseKey":"96:16","text":"Shungi la uwongo, lenye makosa!"},{"verseNumber":17,"verseKey":"96:17","text":"Basi na awaite wenzake!"},{"verseNumber":18,"verseKey":"96:18","text":"Nasi tutawaita Mazabania!"},{"verseNumber":19,"verseKey":"96:19","text":"Hasha! Usimt'ii! Nawe sujudu na ujongee!"}]}