{"id":111,"slug":"barwani-sw","resourceId":49,"nameNative":"Ali Muhsin Al-Barwani (Kiswahili)","nameAr":"البرواني","nameEn":"Ali Muhsin Al-Barwani","lang":"sw","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"111:1","text":"Imeangamia mikono ya Abu Lahab, na yeye pia ameangamia."},{"verseNumber":2,"verseKey":"111:2","text":"Hayatamfaa mali yake, wala alivyo vichuma."},{"verseNumber":3,"verseKey":"111:3","text":"Atauingia Moto wenye mwako."},{"verseNumber":4,"verseKey":"111:4","text":"Na mkewe, mchukuzi wa kuni,"},{"verseNumber":5,"verseKey":"111:5","text":"Shingoni mwake iko kamba iliyo sokotwa."}]}