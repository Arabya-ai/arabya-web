{"id":86,"slug":"barwani-sw","resourceId":49,"nameNative":"Ali Muhsin Al-Barwani (Kiswahili)","nameAr":"البرواني","nameEn":"Ali Muhsin Al-Barwani","lang":"sw","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"86:1","text":"Naapa kwa mbingu na Kinacho kuja usiku!"},{"verseNumber":2,"verseKey":"86:2","text":"Na nini kitakacho kujuulisha ni nini hicho Kinacho kuja usiku?"},{"verseNumber":3,"verseKey":"86:3","text":"Ni Nyota yenye mwanga mkali."},{"verseNumber":4,"verseKey":"86:4","text":"Hapana nafsi ila inayo mwangalizi."},{"verseNumber":5,"verseKey":"86:5","text":"Hebu naajitazame mwanaadamu ameumbwa kwa kitu gani?"},{"verseNumber":6,"verseKey":"86:6","text":"Ameumbwa kwa maji yatokayo kwa kuchupa,"},{"verseNumber":7,"verseKey":"86:7","text":"Yatokayo baina ya mifupa ya mgongo na mbavu."},{"verseNumber":8,"verseKey":"86:8","text":"Hakika Yeye ana uweza wa kumrudisha."},{"verseNumber":9,"verseKey":"86:9","text":"Siku zitakapo dhihirishwa siri."},{"verseNumber":10,"verseKey":"86:10","text":"Basi hatakuwa na nguvu wala msaidizi."},{"verseNumber":11,"verseKey":"86:11","text":"Naapa kwa mbingu yenye marejeo!"},{"verseNumber":12,"verseKey":"86:12","text":"Na kwa ardhi inayo pasuka!"},{"verseNumber":13,"verseKey":"86:13","text":"Hakika hii ni kauli ya kupambanua."},{"verseNumber":14,"verseKey":"86:14","text":"Wala si mzaha."},{"verseNumber":15,"verseKey":"86:15","text":"Hakika wao wanapanga mpango."},{"verseNumber":16,"verseKey":"86:16","text":"Na Mimi napanga mpango."},{"verseNumber":17,"verseKey":"86:17","text":"Basi wape muhula makafiri - wape muhula pole pole."}]}