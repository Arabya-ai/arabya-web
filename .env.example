# Auth.js / NextAuth — لا ترفع القيم الحقيقية إلى Git
# انسخ هذا الملف إلى .env.local واملأ القيم (انظر docs/platform/accounts-owner-guide-ar.md)

# مفتاح عشوائي لحماية الجلسات (ولّده مرة واحدة: openssl rand -base64 32)
AUTH_SECRET=

# Auth.js v5 — ثق بالـ Host خلف LiteSpeed/Cloudflare (Contabo)
AUTH_TRUST_HOST=true

# اختياري في Auth.js v5 — إن وُضع يجب أن يكون الأصل فقط بدون مسار وبدون خطأ إملائي:
# صحيح: https://www.arabya.org
# خطأ شائع: https:/www.arabya.org  أو  .../api/auth/callback/google
# AUTH_URL=https://www.arabya.org
# أثناء النقل إلى Render المجاني استخدم أولاً:
# AUTH_URL=https://arabya-web.onrender.com
# الدليل: docs/platform/hosting-free-render-ar.md

# من Google Cloud → Credentials → OAuth client
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# بريد Gmail للمدير (يمكن أكثر من بريد مفصول بفاصلة)
ARABYA_ADMIN_EMAILS=

# بريد إضافي لخطة عربية بلس (مفصول بفاصلة) — فوق قائمة المالك المضمّنة في الكود
# ARABYA_PLUS_EMAILS=you@example.com

# مفاتيح Pexels لبحث خلفيات الاستوديو ولفيديو الذكاء الاصطناعي عبر API (مفتاح واحد أو عدة مفصولة بفاصلة)
# PEXELS_API_KEY=key1,key2
# PEXELS_API_KEYS=key3

# مفاتيح Pixabay (منفصلة عن Pexels؛ لا تخلط المفاتيح)
# PIXABAY_API_KEY=key1,key2
# PIXABAY_API_KEYS=key3

# مزامنة بيانات الحساب (مفضّل على Contabo — SQLite محلي)
ARABYA_USER_SYNC_ENABLED=0
# ARABYA_USER_DB_PATH=/var/lib/arabya/user-data.sqlite

# Cloudflare Web Analytics (اختياري — token من لوحة Cloudflare)
# NEXT_PUBLIC_CF_BEACON_TOKEN=

# دخول اختبار محلي فقط (Playwright / وكيل). يُتجاهل دائمًا عند NODE_ENV=production
# ARABYA_E2E_AUTH=1
# ARABYA_E2E_EMAIL=e2e@arabya.local

# مزامنة D1 عبر Cloudflare Worker (legacy — لم يعد مستخدماً على Contabo)
ARABYA_D1_ENABLED=0
ARABYA_SYNC_URL=
ARABYA_SYNC_SECRET=

# محرك MoneyPrinterTurbo بجانب استوديو الآيات (اختياري — /studio/ai)
# شغّل محلياً: docker compose -f docker-compose.mpt.yml up
# MONEYPRINTER_API_URL=http://127.0.0.1:8080
# على Contabo: scripts/contabo-mpt-deploy.sh يقرأ المفاتيح من هنا (لا ترفع الملف إلى Git)
# MPT_DAHL_API_KEYS=dahl_new,dahl_old
# MPT_DAHL_MODELS=MiniMaxAI/MiniMax-M2.7,moonshotai/Kimi-K2.6,deepseek-ai/DeepSeek-V4-Flash-0731

# لغوي — المدقق اللغوي (حصة مشروع مدقق العربية + BYOK + Auto)
# LUGHAWI_MONTHLY_QUOTA_CHARS=15000
# LUGHAWI_MAX_GUEST_CHARS=8000
# مفتاح واحد (قديم):
# LUGHAWI_PROJECT_AI_PROVIDER=groq
# LUGHAWI_PROJECT_AI_KEY=
# مجمّع Auto (مفضّل) — افصل بـ |  مثال: groq:gsk_xxx|google:AIza...|openai:sk-...
# LUGHAWI_PROJECT_AI_POOL=
# أو مفاتيح منفصلة (تُجمع تلقائيًا في Auto):
# LUGHAWI_GROQ_API_KEY=
# LUGHAWI_GOOGLE_API_KEY=
# LUGHAWI_OPENROUTER_API_KEY=
# LUGHAWI_OPENAI_API_KEY=
# LUGHAWI_ANTHROPIC_API_KEY=
# نماذج اختيارية:
# LUGHAWI_GROQ_MODEL=llama-3.3-70b-versatile
# LUGHAWI_GOOGLE_MODEL=gemini-2.0-flash
# LUGHAWI_OPENAI_MODEL=gpt-4o-mini
# LUGHAWI_CREDENTIALS_SECRET=
# LUGHAWI_QUOTA_PATH=
# LUGHAWI_CREDENTIALS_PATH=
