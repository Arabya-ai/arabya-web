{"id":90,"slug":"barwani-sw","resourceId":49,"nameNative":"Ali Muhsin Al-Barwani (Kiswahili)","nameAr":"البرواني","nameEn":"Ali Muhsin Al-Barwani","lang":"sw","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"90:1","text":"Naapa kwa Mji huu!"},{"verseNumber":2,"verseKey":"90:2","text":"Nawe unaukaa Mji huu."},{"verseNumber":3,"verseKey":"90:3","text":"Na naapa kwa mzazi na alicho kizaa."},{"verseNumber":4,"verseKey":"90:4","text":"Hakika tumemuumba mtu katika taabu."},{"verseNumber":5,"verseKey":"90:5","text":"Ati anadhani hapana yeyote ataye muweza?"},{"verseNumber":6,"verseKey":"90:6","text":"Anasema: Nimeteketeza chungu ya mali."},{"verseNumber":7,"verseKey":"90:7","text":"Ati anadhani ya kuwa hapana yeyote anaye mwona?"},{"verseNumber":8,"verseKey":"90:8","text":"Kwani hatukumpa macho mawili?"},{"verseNumber":9,"verseKey":"90:9","text":"Na ulimi, na midomo miwili?"},{"verseNumber":10,"verseKey":"90:10","text":"Na tukambainishia zote njia mbili?"},{"verseNumber":11,"verseKey":"90:11","text":"Lakini hakujitoma kwenye njia ya vikwazo vya milimani."},{"verseNumber":12,"verseKey":"90:12","text":"Na nini kitakujuvya ni nini njia ya vikwazo vya milimani?"},{"verseNumber":13,"verseKey":"90:13","text":"Kumkomboa mtumwa;"},{"verseNumber":14,"verseKey":"90:14","text":"Au kumlisha siku ya njaa"},{"verseNumber":15,"verseKey":"90:15","text":"Yatima aliye jamaa,"},{"verseNumber":16,"verseKey":"90:16","text":"Au masikini aliye vumbini."},{"verseNumber":17,"verseKey":"90:17","text":"Tena awe miongoni mwa walio amini na wakausiana kusubiri na wakausiana kuhurumiana."},{"verseNumber":18,"verseKey":"90:18","text":"Hao ndio watu wa kheri wa kuliani."},{"verseNumber":19,"verseKey":"90:19","text":"Lakini walio zikataa Ishara zetu, hao ndio watu wa shari wa kushotoni."},{"verseNumber":20,"verseKey":"90:20","text":"Juu yao utakuwa Moto ulio fungiwa kila upande."}]}