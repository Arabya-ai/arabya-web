{"id":112,"slug":"ahmeti-sq","resourceId":89,"nameNative":"Sherif Ahmeti (Shqip)","nameAr":"أحمتي","nameEn":"Albanian Translation (Ahmeti)","lang":"sq","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"112:1","text":"Thuaj: Ai, All-llahu është Një!"},{"verseNumber":2,"verseKey":"112:2","text":"All-llahu është mbështetja (Atij i mbështetet çdo krijesë)."},{"verseNumber":3,"verseKey":"112:3","text":"As s’ka lindur kë, as nuk është i lindur."},{"verseNumber":4,"verseKey":"112:4","text":"Dhe Atij askush nuk i është i barabartë."}]}