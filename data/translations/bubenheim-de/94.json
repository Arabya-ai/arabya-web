{"id":94,"slug":"bubenheim-de","resourceId":27,"nameNative":"Bubenheim & Elyas (Deutsch)","nameAr":"بوبنهايم","nameEn":"Frank Bubenheim and Nadeem Elyas","lang":"de","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"94:1","text":"Haben Wir dir nicht deine Brust aufgetan"},{"verseNumber":2,"verseKey":"94:2","text":"und dir deine Last abgenommen,"},{"verseNumber":3,"verseKey":"94:3","text":"die deinen Rücken niederdrückte,"},{"verseNumber":4,"verseKey":"94:4","text":"und dir dein Ansehen erhöht?"},{"verseNumber":5,"verseKey":"94:5","text":"Also gewiß, mit der Erschwernis ist Erleichterung,"},{"verseNumber":6,"verseKey":"94:6","text":"gewiß, mit der Erschwernis ist Erleichterung."},{"verseNumber":7,"verseKey":"94:7","text":"Wenn du nun fertig bist, dann strenge dich an"},{"verseNumber":8,"verseKey":"94:8","text":"und nach deinem Herrn richte dein Begehren aus."}]}