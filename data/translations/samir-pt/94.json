{"id":94,"slug":"samir-pt","resourceId":43,"nameNative":"Samir (Português)","nameAr":"سمير","nameEn":"Portuguese Translation (Samir)","lang":"pt","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"94:1","text":"Acaso, não confortamos o teu peito,"},{"verseNumber":2,"verseKey":"94:2","text":"E aliviamos o teu fardo,"},{"verseNumber":3,"verseKey":"94:3","text":"Que feria as tuas costas,"},{"verseNumber":4,"verseKey":"94:4","text":"E enaltecemos a tua reputação?"},{"verseNumber":5,"verseKey":"94:5","text":"Em verdade, com a adversidade está a facilidade!"},{"verseNumber":6,"verseKey":"94:6","text":"Certamente, com a adversidade está a facilidade!"},{"verseNumber":7,"verseKey":"94:7","text":"Assim, pois, quando estiveres livre (dos teus afazeres), continua a prédica,"},{"verseNumber":8,"verseKey":"94:8","text":"E volta para o teu Senhor (toda) a atenção."}]}