{"id":94,"slug":"pickthall-en","resourceId":19,"nameNative":"M. Pickthall (English)","nameAr":"بكثال","nameEn":"M. Pickthall","lang":"en","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"94:1","text":"Have We not caused thy bosom to dilate,"},{"verseNumber":2,"verseKey":"94:2","text":"And eased thee of the burden"},{"verseNumber":3,"verseKey":"94:3","text":"Which weighed down thy back;"},{"verseNumber":4,"verseKey":"94:4","text":"And exalted thy fame?"},{"verseNumber":5,"verseKey":"94:5","text":"But lo! with hardship goeth ease,"},{"verseNumber":6,"verseKey":"94:6","text":"Lo! with hardship goeth ease;"},{"verseNumber":7,"verseKey":"94:7","text":"So when thou art relieved, still toil"},{"verseNumber":8,"verseKey":"94:8","text":"And strive to please thy Lord."}]}