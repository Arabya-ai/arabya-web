{"id":94,"slug":"barwani-sw","resourceId":49,"nameNative":"Ali Muhsin Al-Barwani (Kiswahili)","nameAr":"البرواني","nameEn":"Ali Muhsin Al-Barwani","lang":"sw","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"94:1","text":"Hatukukunjulia kifua chako?"},{"verseNumber":2,"verseKey":"94:2","text":"Na tukakuondolea mzigo wako,"},{"verseNumber":3,"verseKey":"94:3","text":"Ulio vunja mgongo wako?"},{"verseNumber":4,"verseKey":"94:4","text":"Na tukakunyanyulia utajo wako?"},{"verseNumber":5,"verseKey":"94:5","text":"Basi kwa hakika pamoja na uzito upo wepesi,"},{"verseNumber":6,"verseKey":"94:6","text":"Hakika pamoja na uzito upo wepesi."},{"verseNumber":7,"verseKey":"94:7","text":"Na ukipata faragha, fanya juhudi."},{"verseNumber":8,"verseKey":"94:8","text":"Na Mola wako Mlezi ndio mshughulikie."}]}