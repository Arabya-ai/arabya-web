{"id":94,"slug":"knut-sv","resourceId":48,"nameNative":"Knut Bernström (Svenska)","nameAr":"كنوت","nameEn":"Knut Bernström","lang":"sv","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"94:1","text":"HAR VI inte öppnat ditt bröst"},{"verseNumber":2,"verseKey":"94:2","text":"och lyft av bördan"},{"verseNumber":3,"verseKey":"94:3","text":"som tyngde din rygg?"},{"verseNumber":4,"verseKey":"94:4","text":"Och lagt ditt namn i var mans mun?"},{"verseNumber":5,"verseKey":"94:5","text":"På prövningen följer lättnad!"},{"verseNumber":6,"verseKey":"94:6","text":"[Ja,] på prövningen följer lättnad!"},{"verseNumber":7,"verseKey":"94:7","text":"Stå upp, när du har fullgjort [din uppgift],"},{"verseNumber":8,"verseKey":"94:8","text":"och vänd dig med hela ditt hjärta [i bön] till din Herre."}]}