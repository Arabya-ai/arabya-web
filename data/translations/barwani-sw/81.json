{"id":81,"slug":"barwani-sw","resourceId":49,"nameNative":"Ali Muhsin Al-Barwani (Kiswahili)","nameAr":"البرواني","nameEn":"Ali Muhsin Al-Barwani","lang":"sw","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"81:1","text":"Jua litakapo kunjwa,"},{"verseNumber":2,"verseKey":"81:2","text":"Na nyota zikazimwa,"},{"verseNumber":3,"verseKey":"81:3","text":"Na milima ikaondolewa,"},{"verseNumber":4,"verseKey":"81:4","text":"Na ngamia wenye mimba pevu watakapo achwa wasishughulikiwe,"},{"verseNumber":5,"verseKey":"81:5","text":"Na wanyama wa mwituni wakakusanywa,"},{"verseNumber":6,"verseKey":"81:6","text":"Na bahari zikawaka moto,"},{"verseNumber":7,"verseKey":"81:7","text":"Na nafsi zikaunganishwa,"},{"verseNumber":8,"verseKey":"81:8","text":"Na msichana aliye zikwa hai atapo ulizwa,"},{"verseNumber":9,"verseKey":"81:9","text":"Kwa kosa gani aliuliwa?"},{"verseNumber":10,"verseKey":"81:10","text":"Na madaftari yatakapo enezwa,"},{"verseNumber":11,"verseKey":"81:11","text":"Na mbingu itapo tanduliwa,"},{"verseNumber":12,"verseKey":"81:12","text":"Na Jahannamu itapo chochewa,"},{"verseNumber":13,"verseKey":"81:13","text":"Na Pepo ikasogezwa,"},{"verseNumber":14,"verseKey":"81:14","text":"Kila nafsi itajua ilicho kihudhurisha."},{"verseNumber":15,"verseKey":"81:15","text":"Naapa kwa nyota zinapo rejea nyuma,"},{"verseNumber":16,"verseKey":"81:16","text":"Zinazo kwenda, kisha zikajificha,"},{"verseNumber":17,"verseKey":"81:17","text":"Na kwa usiku unapo pungua,"},{"verseNumber":18,"verseKey":"81:18","text":"Na kwa asubuhi inapo pambazuka,"},{"verseNumber":19,"verseKey":"81:19","text":"Kwamba hakika bila ya shaka hii ni kauli ya Mjumbe mtukufu,"},{"verseNumber":20,"verseKey":"81:20","text":"Mwenye nguvu na mwenye cheo kwa huyo Mwenye Kiti cha Enzi,"},{"verseNumber":21,"verseKey":"81:21","text":"Anaye t'iiwa, tena muaminifu."},{"verseNumber":22,"verseKey":"81:22","text":"Na wala huyu mwenzenu hana wazimu."},{"verseNumber":23,"verseKey":"81:23","text":"Na hakika yeye alimwona kwenye upeo wa macho ulio safi."},{"verseNumber":24,"verseKey":"81:24","text":"Wala yeye si bakhili kwa mambo ya ghaibu."},{"verseNumber":25,"verseKey":"81:25","text":"Wala hii si kauli ya Shetani maluuni."},{"verseNumber":26,"verseKey":"81:26","text":"Basi mnakwenda wapi?"},{"verseNumber":27,"verseKey":"81:27","text":"Haikuwa hii ila ni ukumbusho kwa walimwengu wote."},{"verseNumber":28,"verseKey":"81:28","text":"Kwa yule miongoni mwenu anaye taka kwenda sawa."},{"verseNumber":29,"verseKey":"81:29","text":"Wala nyinyi hamtataka isipo kuwa atake Mwenyezi Mungu Mola Mlezi wa walimwengu wote."}]}