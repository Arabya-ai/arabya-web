{"id":91,"slug":"ma-jain-zh","resourceId":56,"nameNative":"马坚译（中文）","nameAr":"ما جيان","nameEn":"Chinese Translation (Ma Jian)","lang":"zh","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"91:1","text":"以太阳及其光辉发誓，"},{"verseNumber":2,"verseKey":"91:2","text":"以追随太阳时的月亮发誓，"},{"verseNumber":3,"verseKey":"91:3","text":"以揭示太阳时的白昼发誓，"},{"verseNumber":4,"verseKey":"91:4","text":"以笼罩太阳时的黑夜发誓，"},{"verseNumber":5,"verseKey":"91:5","text":"以苍穹及其建筑者发誓，"},{"verseNumber":6,"verseKey":"91:6","text":"以大地及其铺展者发誓，"},{"verseNumber":7,"verseKey":"91:7","text":"以灵魂及使它均衡，"},{"verseNumber":8,"verseKey":"91:8","text":"并启示他善恶者发誓，"},{"verseNumber":9,"verseKey":"91:9","text":"凡培养自己的性灵者，必定成功；"},{"verseNumber":10,"verseKey":"91:10","text":"凡戕害自己的性灵者，必定失败。"},{"verseNumber":11,"verseKey":"91:11","text":"赛莫德人已因过分而否认真理。"},{"verseNumber":12,"verseKey":"91:12","text":"当时，他们中最薄命者忙上前来，"},{"verseNumber":13,"verseKey":"91:13","text":"使者就对他们说：你们让真主的母驼自由饮水吧。"},{"verseNumber":14,"verseKey":"91:14","text":"但他们否认使者而宰杀母驼，故他们的主因他们的罪过而毁灭他们，使他们普遍受难。"},{"verseNumber":15,"verseKey":"91:15","text":"他是不顾虑那灾难的後果的。"}]}