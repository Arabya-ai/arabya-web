{"id":77,"slug":"ma-jain-zh","resourceId":56,"nameNative":"马坚译（中文）","nameAr":"ما جيان","nameEn":"Chinese Translation (Ma Jian)","lang":"zh","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"77:1","text":"誓以奉派传达佳音，"},{"verseNumber":2,"verseKey":"77:2","text":"遂猛烈吹动者，"},{"verseNumber":3,"verseKey":"77:3","text":"誓以传播各物，"},{"verseNumber":4,"verseKey":"77:4","text":"而使之分散，"},{"verseNumber":5,"verseKey":"77:5","text":"乃传授教训者，"},{"verseNumber":6,"verseKey":"77:6","text":"誓以示原谅或警告者，"},{"verseNumber":7,"verseKey":"77:7","text":"警告你们的事，是必定发生的。"},{"verseNumber":8,"verseKey":"77:8","text":"当星宿黯淡的时候，"},{"verseNumber":9,"verseKey":"77:9","text":"当天体破裂的时候，"},{"verseNumber":10,"verseKey":"77:10","text":"当山峦飞扬的时候，"},{"verseNumber":11,"verseKey":"77:11","text":"当众使者被定期召集的时候，"},{"verseNumber":12,"verseKey":"77:12","text":"期限在哪日呢？"},{"verseNumber":13,"verseKey":"77:13","text":"在判决之日。"},{"verseNumber":14,"verseKey":"77:14","text":"你怎能知道判决之日，是什么？"},{"verseNumber":15,"verseKey":"77:15","text":"在那日，伤哉否认真理的人们。"},{"verseNumber":16,"verseKey":"77:16","text":"难道我没有毁灭先民吗？"},{"verseNumber":17,"verseKey":"77:17","text":"然后，我使后民随他们而消灭。"},{"verseNumber":18,"verseKey":"77:18","text":"我将这样处治犯罪的人。"},{"verseNumber":19,"verseKey":"77:19","text":"在那日，伤哉否认真理的人们。"},{"verseNumber":20,"verseKey":"77:20","text":"难道我没有用薄弱的精液创造你们吗？"},{"verseNumber":21,"verseKey":"77:21","text":". 我把它放在一个坚固的安息之所，"},{"verseNumber":22,"verseKey":"77:22","text":"到一个定期。"},{"verseNumber":23,"verseKey":"77:23","text":"我曾判定，我是善於判定的。"},{"verseNumber":24,"verseKey":"77:24","text":"在那日，伤哉否认真理的人们。"},{"verseNumber":25,"verseKey":"77:25","text":"难道我没有使大地成为包罗"},{"verseNumber":26,"verseKey":"77:26","text":"活物和死物的吗？"},{"verseNumber":27,"verseKey":"77:27","text":"我曾在大地上，安置许多崇高的山峦。我曾赏赐你们甘美的饮料。"},{"verseNumber":28,"verseKey":"77:28","text":"在那日，伤哉否认真理的人们！"},{"verseNumber":29,"verseKey":"77:29","text":"你们去享受你们所否认的刑罚吧！"},{"verseNumber":30,"verseKey":"77:30","text":"你们去享受有三个权的荫影吧！"},{"verseNumber":31,"verseKey":"77:31","text":"那荫影不是阴凉的，不能遮挡火焰的热浪。"},{"verseNumber":32,"verseKey":"77:32","text":"那火焰喷射出宫殿般的火星，"},{"verseNumber":33,"verseKey":"77:33","text":"好像黧黑的骆驼一样。"},{"verseNumber":34,"verseKey":"77:34","text":"在那日，伤哉否认真理的人们！"},{"verseNumber":35,"verseKey":"77:35","text":"这是他们不得发言之日。"},{"verseNumber":36,"verseKey":"77:36","text":"他们不蒙许可，故不能道歉。"},{"verseNumber":37,"verseKey":"77:37","text":"在那日，伤哉否认真理的人们！"},{"verseNumber":38,"verseKey":"77:38","text":"这是判决之日，我把你们和先民集合在一处。"},{"verseNumber":39,"verseKey":"77:39","text":"如果你们有什么计谋，你们可对我用计。"},{"verseNumber":40,"verseKey":"77:40","text":"在那日，伤哉否认真理的人们！"},{"verseNumber":41,"verseKey":"77:41","text":"敬畏的人们，必定在树荫之下，清泉之滨，"},{"verseNumber":42,"verseKey":"77:42","text":"享受他们爱吃的水果，"},{"verseNumber":43,"verseKey":"77:43","text":"将对他们说：你们曾经行善，故你们痛快地饮食吧！"},{"verseNumber":44,"verseKey":"77:44","text":"我必定这样报酬行善的人们。"},{"verseNumber":45,"verseKey":"77:45","text":"在那日，伤哉否认真理的人们。"},{"verseNumber":46,"verseKey":"77:46","text":"你们暂时吃喝享受吧！你们确是犯罪的人。"},{"verseNumber":47,"verseKey":"77:47","text":"在那日，伤哉否认真理的人们！"},{"verseNumber":48,"verseKey":"77:48","text":"有人对他们说：你们当鞠躬。他们不肯鞠躬。"},{"verseNumber":49,"verseKey":"77:49","text":"伤哉否认真理的人们！"},{"verseNumber":50,"verseKey":"77:50","text":"除《古兰经》外，他们要信仰什么文辞呢？"}]}