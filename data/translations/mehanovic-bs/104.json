{"id":104,"slug":"mehanovic-bs","resourceId":25,"nameNative":"Muhamed Mehanović (Bosanski)","nameAr":"مهانوفيتش","nameEn":"Muhamed Mehanović","lang":"bs","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"104:1","text":"Teško svakom klevetniku podrugljivcu,"},{"verseNumber":2,"verseKey":"104:2","text":"koji blago gomila i prebrojava ga,"},{"verseNumber":3,"verseKey":"104:3","text":"i misli da će ga blago njegovo besmrtnim učiniti."},{"verseNumber":4,"verseKey":"104:4","text":"A ne treba tako! On će sigurno biti bačen u Hutamu!"},{"verseNumber":5,"verseKey":"104:5","text":"A znaš li ti šta je Hutama?"},{"verseNumber":6,"verseKey":"104:6","text":"Vatra Allahova razbuktala,"},{"verseNumber":7,"verseKey":"104:7","text":"koja će do srca dopirati."},{"verseNumber":8,"verseKey":"104:8","text":"Ona će nad njima biti zatvorena"},{"verseNumber":9,"verseKey":"104:9","text":"plamenim izduženim stubovima."}]}