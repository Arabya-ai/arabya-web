# Arabya NLP Platform — Contabo only (copy to services/arabya-nlp/.env or repo root .env)

# Bind all interfaces (required so Next/PM2 peers can reach FastAPI on Contabo).
# Pair with UFW + ServerAvatar inbound TCP 8092 — docs/platform/arabya-nlp-port-8092-ar.md
ARABYA_NLP_HOST=0.0.0.0
ARABYA_NLP_PORT=8092

# Local SQLite on Contabo disk (default). Optional local Postgres:
# ARABYA_NLP_DATABASE_URL=postgresql+psycopg2://arabya:SECRET@127.0.0.1:5432/arabya_nlp
ARABYA_NLP_DATABASE_URL=sqlite:////var/lib/arabya/arabya-nlp.sqlite

ARABYA_NLP_SERVER_LOG=/var/log/arabya/arabya-nlp-server.log
ARABYA_NLP_TMP_DIR=/tmp/arabya-nlp

# Local Ollama on the same Contabo host
ARABYA_NLP_OLLAMA_BASE_URL=http://127.0.0.1:11434
ARABYA_NLP_OLLAMA_MODEL=llama3.1:8b
ARABYA_NLP_OLLAMA_DEVOPS_MODEL=llama3.1:8b

# faster-whisper
ARABYA_NLP_WHISPER_SIZE=medium
ARABYA_NLP_WHISPER_DEVICE=cpu
ARABYA_NLP_WHISPER_COMPUTE=int8
ARABYA_NLP_FFMPEG=ffmpeg
ARABYA_NLP_MAX_UPLOAD_BYTES=25000000

# Guest public visitors: 5 requests / hour. Trusted callers use bearer tokens.
ARABYA_NLP_RATE_LIMIT_REQUESTS=5
ARABYA_NLP_RATE_LIMIT_WINDOW=3600
# Comma-separated tokens (also accepted as X-API-Key)
ARABYA_NLP_API_TOKENS=

# DevOps agent — auto_execute=0 recommends only; set 1 to run whitelist actions
ARABYA_NLP_DEVOPS_ENABLED=1
ARABYA_NLP_DEVOPS_INTERVAL=60
ARABYA_NLP_DEVOPS_AUTO_EXECUTE=0

ARABYA_NLP_LLM_PROOFREAD=1
ARABYA_NLP_STREAMLIT_PORT=8501
