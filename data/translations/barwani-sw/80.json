{"id":80,"slug":"barwani-sw","resourceId":49,"nameNative":"Ali Muhsin Al-Barwani (Kiswahili)","nameAr":"البرواني","nameEn":"Ali Muhsin Al-Barwani","lang":"sw","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"80:1","text":"Alikunja kipaji na akageuka,"},{"verseNumber":2,"verseKey":"80:2","text":"Kwa sababu alimjia kipofu!"},{"verseNumber":3,"verseKey":"80:3","text":"Na nini kitakujuulisha pengine yeye atatakasika?"},{"verseNumber":4,"verseKey":"80:4","text":"Au atawaidhika, na mawaidha yamfae?"},{"verseNumber":5,"verseKey":"80:5","text":"Ama ajionaye hana haja,"},{"verseNumber":6,"verseKey":"80:6","text":"Wewe ndio unamshughulikia?"},{"verseNumber":7,"verseKey":"80:7","text":"Na si juu yako kama hakutakasika."},{"verseNumber":8,"verseKey":"80:8","text":"Ama anaye kujia kwa juhudi,"},{"verseNumber":9,"verseKey":"80:9","text":"Naye anaogopa,"},{"verseNumber":10,"verseKey":"80:10","text":"Ndio wewe unampuuza?"},{"verseNumber":11,"verseKey":"80:11","text":"Sivyo hivyo! Huku ni kukumbushana."},{"verseNumber":12,"verseKey":"80:12","text":"Basi anaye penda akumbuke."},{"verseNumber":13,"verseKey":"80:13","text":"Yamo katika kurasa zilizo hishimiwa,"},{"verseNumber":14,"verseKey":"80:14","text":"Zilizo inuliwa, zilizo takaswa."},{"verseNumber":15,"verseKey":"80:15","text":"Zimo mikononi mwa Malaika waandishi,"},{"verseNumber":16,"verseKey":"80:16","text":"Watukufu, wema."},{"verseNumber":17,"verseKey":"80:17","text":"Ameangamia mwanaadamu! Nini kinacho mkufurisha?"},{"verseNumber":18,"verseKey":"80:18","text":"Kwa kitu gani amemuumba?"},{"verseNumber":19,"verseKey":"80:19","text":"Kwa tone la manii, akamuumba na akamkadiria."},{"verseNumber":20,"verseKey":"80:20","text":"Kisha akamsahilishia njia."},{"verseNumber":21,"verseKey":"80:21","text":"Kisha akamfisha, akamtia kaburini."},{"verseNumber":22,"verseKey":"80:22","text":"Kisha apendapo atamfufua."},{"verseNumber":23,"verseKey":"80:23","text":"La! Hajamaliza aliyo muamuru."},{"verseNumber":24,"verseKey":"80:24","text":"Hebu mtu na atazame chakula chake."},{"verseNumber":25,"verseKey":"80:25","text":"Hakika Sisi tumemimina maji kwa nguvu,"},{"verseNumber":26,"verseKey":"80:26","text":"Tena tukaipasua pasua ardhi kwa nguvu,"},{"verseNumber":27,"verseKey":"80:27","text":"Kisha tukaotesha humo nafaka,"},{"verseNumber":28,"verseKey":"80:28","text":"Na zabibu, na mimea ya majani,"},{"verseNumber":29,"verseKey":"80:29","text":"Na mizaituni, na mitende,"},{"verseNumber":30,"verseKey":"80:30","text":"Na bustani zenye miti iliyo songana baraabara,"},{"verseNumber":31,"verseKey":"80:31","text":"Na matunda, na malisho ya wanyama;"},{"verseNumber":32,"verseKey":"80:32","text":"Kwa manufaa yenu na mifugo yenu."},{"verseNumber":33,"verseKey":"80:33","text":"Basi utakapo kuja ukelele,"},{"verseNumber":34,"verseKey":"80:34","text":"Siku ambayo mtu atamkimbia nduguye,"},{"verseNumber":35,"verseKey":"80:35","text":"Na mamaye na babaye,"},{"verseNumber":36,"verseKey":"80:36","text":"Na mkewe na wanawe -"},{"verseNumber":37,"verseKey":"80:37","text":"Kila mtu miongoni mwao siku hiyo atakuwa na lake la kumtosha."},{"verseNumber":38,"verseKey":"80:38","text":"Siku hiyo ziko nyuso zitazo nawiri,"},{"verseNumber":39,"verseKey":"80:39","text":"Zitacheka, zitachangamka;"},{"verseNumber":40,"verseKey":"80:40","text":"Na nyuso siku hiyo zitakuwa na mavumbi,"},{"verseNumber":41,"verseKey":"80:41","text":"Giza totoro litazifunika,"},{"verseNumber":42,"verseKey":"80:42","text":"Hao ndio makafiri watenda maovu."}]}