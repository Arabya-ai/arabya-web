{"id":107,"slug":"barwani-sw","resourceId":49,"nameNative":"Ali Muhsin Al-Barwani (Kiswahili)","nameAr":"البرواني","nameEn":"Ali Muhsin Al-Barwani","lang":"sw","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"107:1","text":"Je! Umemwona anaye kadhibisha Malipo?"},{"verseNumber":2,"verseKey":"107:2","text":"Huyo ndiye anaye msukuma yatima,"},{"verseNumber":3,"verseKey":"107:3","text":"Wala hahimizi kumlisha masikini."},{"verseNumber":4,"verseKey":"107:4","text":"Basi, ole wao wanao sali,"},{"verseNumber":5,"verseKey":"107:5","text":"Ambao wanapuuza Sala zao;"},{"verseNumber":6,"verseKey":"107:6","text":"Ambao wanajionyesha,"},{"verseNumber":7,"verseKey":"107:7","text":"Nao huku wanazuia msaada."}]}