{"id":111,"slug":"pickthall-en","resourceId":19,"nameNative":"M. Pickthall (English)","nameAr":"بكثال","nameEn":"M. Pickthall","lang":"en","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"111:1","text":"The power of Abu Lahab will perish, and he will perish."},{"verseNumber":2,"verseKey":"111:2","text":"His wealth and gains will not exempt him."},{"verseNumber":3,"verseKey":"111:3","text":"He will be plunged in flaming Fire,"},{"verseNumber":4,"verseKey":"111:4","text":"And his wife, the wood-carrier,"},{"verseNumber":5,"verseKey":"111:5","text":"Will have upon her neck a halter of palm-fibre."}]}