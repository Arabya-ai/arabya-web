{"id":114,"slug":"barwani-sw","resourceId":49,"nameNative":"Ali Muhsin Al-Barwani (Kiswahili)","nameAr":"البرواني","nameEn":"Ali Muhsin Al-Barwani","lang":"sw","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"114:1","text":"Sema: Ninajikinga kwa Mola Mlezi wa wanaadamu,"},{"verseNumber":2,"verseKey":"114:2","text":"Mfalme wa wanaadamu,"},{"verseNumber":3,"verseKey":"114:3","text":"Mungu wa wanaadamu,"},{"verseNumber":4,"verseKey":"114:4","text":"Na shari ya wasiwasi wa Shetani, Khannas,"},{"verseNumber":5,"verseKey":"114:5","text":"Anaye tia wasiwasi katika vifua vya watu,"},{"verseNumber":6,"verseKey":"114:6","text":"Kutokana na majini na wanaadamu."}]}