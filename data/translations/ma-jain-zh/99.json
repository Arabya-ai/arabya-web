{"id":99,"slug":"ma-jain-zh","resourceId":56,"nameNative":"马坚译（中文）","nameAr":"ما جيان","nameEn":"Chinese Translation (Ma Jian)","lang":"zh","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"99:1","text":"当大地猛烈地震动,"},{"verseNumber":2,"verseKey":"99:2","text":"抛其重担,"},{"verseNumber":3,"verseKey":"99:3","text":"说大地怎麽啦?"},{"verseNumber":4,"verseKey":"99:4","text":"在那日, 大地将报告它的消息。"},{"verseNumber":5,"verseKey":"99:5","text":"因为你的主已启示了它;"},{"verseNumber":6,"verseKey":"99:6","text":"在那日, 人们将纷纷地离散,"},{"verseNumber":7,"verseKey":"99:7","text":"以便他们得见自己行为的报应。"},{"verseNumber":8,"verseKey":"99:8","text":"行一个小蚂蚁重的善事者, 将见其善报; 作一个小蚂蚁重的恶事者, 将见其恶报。"}]}