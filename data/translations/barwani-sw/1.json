{"id":1,"slug":"barwani-sw","resourceId":49,"nameNative":"Ali Muhsin Al-Barwani (Kiswahili)","nameAr":"البرواني","nameEn":"Ali Muhsin Al-Barwani","lang":"sw","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"1:1","text":"KWA JINA LA MWENYEZI MUNGU MWINGI WA REHEMA MWENYE KUREHEMU."},{"verseNumber":2,"verseKey":"1:2","text":"Sifa njema zote ni za Mwenyezi Mungu, Mola Mlezi wa viumbe vyote;"},{"verseNumber":3,"verseKey":"1:3","text":"Mwingi wa Rehema Mwenye Kurehemu;"},{"verseNumber":4,"verseKey":"1:4","text":"Mwenye Kumiliki Siku ya Malipo."},{"verseNumber":5,"verseKey":"1:5","text":"Wewe tu tunakuabudu, na Wewe tu tunakuomba msaada."},{"verseNumber":6,"verseKey":"1:6","text":"Tuongoe njia iliyo nyooka,"},{"verseNumber":7,"verseKey":"1:7","text":"Njia ya ulio waneemesha, siyo ya walio kasirikiwa, wala walio potea."}]}