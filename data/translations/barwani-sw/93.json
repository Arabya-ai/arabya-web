{"id":93,"slug":"barwani-sw","resourceId":49,"nameNative":"Ali Muhsin Al-Barwani (Kiswahili)","nameAr":"البرواني","nameEn":"Ali Muhsin Al-Barwani","lang":"sw","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"93:1","text":"Naapa kwa mchana!"},{"verseNumber":2,"verseKey":"93:2","text":"Na kwa usiku unapo tanda!"},{"verseNumber":3,"verseKey":"93:3","text":"Mola wako Mlezi hakukuacha, wala hakukasirika nawe."},{"verseNumber":4,"verseKey":"93:4","text":"Na bila ya shaka wakati ujao utakuwa bora kwako kuliko ulio tangulia."},{"verseNumber":5,"verseKey":"93:5","text":"Na Mola wako Mlezi atakupa mpaka uridhike."},{"verseNumber":6,"verseKey":"93:6","text":"Kwani hakukukuta yatima akakupa makaazi?"},{"verseNumber":7,"verseKey":"93:7","text":"Na akakukuta umepotea akakuongoa?"},{"verseNumber":8,"verseKey":"93:8","text":"Akakukuta mhitaji akakutosheleza?"},{"verseNumber":9,"verseKey":"93:9","text":"Basi yatima usimwonee!"},{"verseNumber":10,"verseKey":"93:10","text":"Na anaye omba au kuuliza usimkaripie!"},{"verseNumber":11,"verseKey":"93:11","text":"Na neema za Mola wako Mlezi zisimlie."}]}