{"id":81,"slug":"ma-jain-zh","resourceId":56,"nameNative":"马坚译（中文）","nameAr":"ما جيان","nameEn":"Chinese Translation (Ma Jian)","lang":"zh","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"81:1","text":"当太阳黯黜的时候，"},{"verseNumber":2,"verseKey":"81:2","text":"当星宿零落的时候，"},{"verseNumber":3,"verseKey":"81:3","text":"当山峦崩溃的时候，"},{"verseNumber":4,"verseKey":"81:4","text":"当孕驼被抛弃的时候，"},{"verseNumber":5,"verseKey":"81:5","text":"当野兽被集合的时候，"},{"verseNumber":6,"verseKey":"81:6","text":"当海洋澎湃的时候，"},{"verseNumber":7,"verseKey":"81:7","text":"当灵魂被配合的时候，"},{"verseNumber":8,"verseKey":"81:8","text":"当被活埋的女孩被询问的时候："},{"verseNumber":9,"verseKey":"81:9","text":"她为什么罪过而遭杀害呢？"},{"verseNumber":10,"verseKey":"81:10","text":"当功过簿被展开的时候，"},{"verseNumber":11,"verseKey":"81:11","text":"当天皮被揭去的时候，"},{"verseNumber":12,"verseKey":"81:12","text":"当火狱被燃著的时候，"},{"verseNumber":13,"verseKey":"81:13","text":"当乐园被送近的时候，"},{"verseNumber":14,"verseKey":"81:14","text":"每个人都知道他所作过的善恶。"},{"verseNumber":15,"verseKey":"81:15","text":"我誓以运行的众星--"},{"verseNumber":16,"verseKey":"81:16","text":"没落的行星，"},{"verseNumber":17,"verseKey":"81:17","text":"和逝去时的黑夜，"},{"verseNumber":18,"verseKey":"81:18","text":"照耀时的早晨，"},{"verseNumber":19,"verseKey":"81:19","text":"这确是一个尊贵的使者的言辞，"},{"verseNumber":20,"verseKey":"81:20","text":"他在宝座的主那里，是有权力的，是有地位的，"},{"verseNumber":21,"verseKey":"81:21","text":"是众望所归，而且忠於职守的。"},{"verseNumber":22,"verseKey":"81:22","text":"你们的朋友，不是一个疯人，"},{"verseNumber":23,"verseKey":"81:23","text":"他确已看见那个天使在明显的天边，"},{"verseNumber":24,"verseKey":"81:24","text":"他对幽玄不是吝教的。"},{"verseNumber":25,"verseKey":"81:25","text":"这不是被放逐的恶魔的言辞，"},{"verseNumber":26,"verseKey":"81:26","text":"然则, 你们将往那里去呢？"},{"verseNumber":27,"verseKey":"81:27","text":"这只是对於全世界的教诲--"},{"verseNumber":28,"verseKey":"81:28","text":"对於你们中欲循规蹈矩者的教诲，"},{"verseNumber":29,"verseKey":"81:29","text":"你们不欲循规蹈矩，除非真主--全世界的主--意欲的时候。"}]}