{"id":107,"slug":"mehanovic-bs","resourceId":25,"nameNative":"Muhamed Mehanović (Bosanski)","nameAr":"مهانوفيتش","nameEn":"Muhamed Mehanović","lang":"bs","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"107:1","text":"Znaš li ti onoga koji Sud poriče?"},{"verseNumber":2,"verseKey":"107:2","text":"Pa to je onaj koji grubo odbija siroče."},{"verseNumber":3,"verseKey":"107:3","text":"i koji da se nahrani siromah - ne podstiče."},{"verseNumber":4,"verseKey":"107:4","text":"Pa teško klanjačima,"},{"verseNumber":5,"verseKey":"107:5","text":"onima koji su nemarni prema svome namazu."},{"verseNumber":6,"verseKey":"107:6","text":"koji se samo ljudima pokazuju"},{"verseNumber":7,"verseKey":"107:7","text":"čak potrepštine koje se na posudbu daju oni ne daju!"}]}