{"id":89,"slug":"ma-jain-zh","resourceId":56,"nameNative":"马坚译（中文）","nameAr":"ما جيان","nameEn":"Chinese Translation (Ma Jian)","lang":"zh","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"89:1","text":"誓以黎明，"},{"verseNumber":2,"verseKey":"89:2","text":"与十夜，"},{"verseNumber":3,"verseKey":"89:3","text":"与偶数和奇数，"},{"verseNumber":4,"verseKey":"89:4","text":"与离去的黑夜，"},{"verseNumber":5,"verseKey":"89:5","text":"对於有理智者，此中有一种盟誓吗？"},{"verseNumber":6,"verseKey":"89:6","text":"难道你不知道你的主怎样惩治阿德人---"},{"verseNumber":7,"verseKey":"89:7","text":"有高柱的伊赖姆人吗？"},{"verseNumber":8,"verseKey":"89:8","text":"像那样的人，在别的城市里还没有被创造过的---"},{"verseNumber":9,"verseKey":"89:9","text":"怎样惩治在山谷里凿石为家的赛莫德人，"},{"verseNumber":10,"verseKey":"89:10","text":"怎样惩治有武力的法老。"},{"verseNumber":11,"verseKey":"89:11","text":"这等人曾在国中放肆，"},{"verseNumber":12,"verseKey":"89:12","text":"乃多行不义，"},{"verseNumber":13,"verseKey":"89:13","text":"故你的主把一种刑罚，倾注在他们身上。"},{"verseNumber":14,"verseKey":"89:14","text":"你的主，确是监视的。"},{"verseNumber":15,"verseKey":"89:15","text":"至於人，当他的主考验他，故优待他，而且使他过安逸生活的时候，他说：我的主优待我了。"},{"verseNumber":16,"verseKey":"89:16","text":"当他考验他，故节约他的给养的时候，他说：我的主凌辱我了。"},{"verseNumber":17,"verseKey":"89:17","text":"绝不然！但你们不优待孤儿，"},{"verseNumber":18,"verseKey":"89:18","text":"你们不以济贫相勉励，"},{"verseNumber":19,"verseKey":"89:19","text":"你们侵吞遗产，"},{"verseNumber":20,"verseKey":"89:20","text":"你们酷爱钱财。"},{"verseNumber":21,"verseKey":"89:21","text":"绝不然！当大地震动复震动，"},{"verseNumber":22,"verseKey":"89:22","text":"你的主的命令，和排班的天神，同齐来临的时候，"},{"verseNumber":23,"verseKey":"89:23","text":"在那日，火狱将被拿来；在那日，人将觉悟，但觉悟於他有何裨益呢？"},{"verseNumber":24,"verseKey":"89:24","text":"他将说：但愿我在世的时候曾行善事。"},{"verseNumber":25,"verseKey":"89:25","text":"在那日，任何人，不用他的那种刑罚惩治别人；"},{"verseNumber":26,"verseKey":"89:26","text":"任何人，不用他的那种束缚束缚别人。"},{"verseNumber":27,"verseKey":"89:27","text":"安定的灵魂啊！"},{"verseNumber":28,"verseKey":"89:28","text":"你应当喜悦地，被喜悦地归於你的主。"},{"verseNumber":29,"verseKey":"89:29","text":"你应当入在我的众仆里；"},{"verseNumber":30,"verseKey":"89:30","text":"你应当入在我的乐园里。"}]}