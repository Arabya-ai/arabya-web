{"id":109,"slug":"isa-garcia-es","resourceId":83,"nameNative":"Isa García (Español)","nameAr":"عيسى غارسيا","nameEn":"Sheikh Isa Garcia","lang":"es","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"109:1","text":"Di: “¡Oh, incrédulos!"},{"verseNumber":2,"verseKey":"109:2","text":"No adoro lo que adoráis."},{"verseNumber":3,"verseKey":"109:3","text":"Ni vosotros adoráis a Quien yo adoro."},{"verseNumber":4,"verseKey":"109:4","text":"Y jamás adoraré lo que adoráis."},{"verseNumber":5,"verseKey":"109:5","text":"Ni adoraréis vosotros a Quien yo adoro."},{"verseNumber":6,"verseKey":"109:6","text":"Vosotros tenéis vuestra religión y yo la mía”."}]}