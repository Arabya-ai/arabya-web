{"id":106,"slug":"kuliev-ru","resourceId":45,"nameNative":"Эльмир Кулиев (Русский)","nameAr":"كولييف","nameEn":"Elmir Kuliev","lang":"ru","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"106:1","text":"Ради единения курейшитов,"},{"verseNumber":2,"verseKey":"106:2","text":"единения их во время зимних и летних поездок."},{"verseNumber":3,"verseKey":"106:3","text":"Пусть же они поклоняются Господу этого Дома (Каабы),"},{"verseNumber":4,"verseKey":"106:4","text":"Который накормил их после голода и избавил их от страха."}]}