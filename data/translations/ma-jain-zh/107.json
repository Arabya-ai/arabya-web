{"id":107,"slug":"ma-jain-zh","resourceId":56,"nameNative":"马坚译（中文）","nameAr":"ما جيان","nameEn":"Chinese Translation (Ma Jian)","lang":"zh","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"107:1","text":"你曾见否认报应日的人吗？"},{"verseNumber":2,"verseKey":"107:2","text":"他就是那个呵斥孤儿,"},{"verseNumber":3,"verseKey":"107:3","text":"且不勉励人赈济贫民的人。"},{"verseNumber":4,"verseKey":"107:4","text":"伤哉！礼拜的人们,"},{"verseNumber":5,"verseKey":"107:5","text":"他们是忽视拜功的,"},{"verseNumber":6,"verseKey":"107:6","text":"他们是沽名钓誉的,"},{"verseNumber":7,"verseKey":"107:7","text":"他们是不肯借人什物的。"}]}