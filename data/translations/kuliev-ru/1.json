{"id":1,"slug":"kuliev-ru","resourceId":45,"nameNative":"Эльмир Кулиев (Русский)","nameAr":"كولييف","nameEn":"Elmir Kuliev","lang":"ru","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"1:1","text":"Во имя Аллаха, Милостивого, Милосердного!"},{"verseNumber":2,"verseKey":"1:2","text":"Хвала Аллаху, Господу миров,"},{"verseNumber":3,"verseKey":"1:3","text":"Милостивому, Милосердному,"},{"verseNumber":4,"verseKey":"1:4","text":"Властелину Дня воздаяния!"},{"verseNumber":5,"verseKey":"1:5","text":"Тебе одному мы поклоняемся и Тебя одного молим о помощи."},{"verseNumber":6,"verseKey":"1:6","text":"Веди нас прямым путем,"},{"verseNumber":7,"verseKey":"1:7","text":"путем тех, кого Ты облагодетельствовал, не тех, на кого пал гнев, и не заблудших."}]}