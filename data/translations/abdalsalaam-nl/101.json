{"id":101,"slug":"abdalsalaam-nl","resourceId":235,"nameNative":"Abdalsalaam (Nederlands)","nameAr":"عبدالسلام","nameEn":"Malak Faris Abdalsalaam","lang":"nl","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"101:1","text":"De ramp."},{"verseNumber":2,"verseKey":"101:2","text":"Wat is de ramp?"},{"verseNumber":3,"verseKey":"101:3","text":"En wat laat jou weten wat de ramp is?"},{"verseNumber":4,"verseKey":"101:4","text":"Dat is de dag waarop de mensheid lijkt op verspreide motten."},{"verseNumber":5,"verseKey":"101:5","text":"En de bergen lijken op gekaarde wol."},{"verseNumber":6,"verseKey":"101:6","text":"Voor degenen wiens weegschaal (met goede daden) dan zwaar weegt."},{"verseNumber":7,"verseKey":"101:7","text":"Hij zal een plezierig leven leiden."},{"verseNumber":8,"verseKey":"101:8","text":"Maar voor degene wiens weegschaal licht weegt."},{"verseNumber":9,"verseKey":"101:9","text":"Zijn toevlucht is de Hel."},{"verseNumber":10,"verseKey":"101:10","text":"En wat laat jou weten wat zij is?"},{"verseNumber":11,"verseKey":"101:11","text":"Dat is een laaiend Vuur!"}]}