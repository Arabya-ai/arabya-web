{"id":104,"slug":"abdalsalaam-nl","resourceId":235,"nameNative":"Abdalsalaam (Nederlands)","nameAr":"عبدالسلام","nameEn":"Malak Faris Abdalsalaam","lang":"nl","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"104:1","text":"Wee voor de lasteraar en de leugenaar."},{"verseNumber":2,"verseKey":"104:2","text":"Die de rijkdom verzamelt en deze telt."},{"verseNumber":3,"verseKey":"104:3","text":"Hij denkt dat zijn bezit hem eeuwiglevend maakt."},{"verseNumber":4,"verseKey":"104:4","text":"Nee! Waarlijk, hij zal in het verpletterende Vuur gegooid worden."},{"verseNumber":5,"verseKey":"104:5","text":"En wat laat jou weten wat het verpletterende Vuur is?"},{"verseNumber":6,"verseKey":"104:6","text":"Het Vuur dat Allah heeft aangestoken."},{"verseNumber":7,"verseKey":"104:7","text":"Wat naar hun harten opspringt."},{"verseNumber":8,"verseKey":"104:8","text":"Waarlijk, het zal hen insluiten."},{"verseNumber":9,"verseKey":"104:9","text":"In langgerekte zuilen."}]}