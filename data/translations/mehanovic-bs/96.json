{"id":96,"slug":"mehanovic-bs","resourceId":25,"nameNative":"Muhamed Mehanović (Bosanski)","nameAr":"مهانوفيتش","nameEn":"Muhamed Mehanović","lang":"bs","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"96:1","text":"Čitaj s imenom Gospodara tvoga Koji stvara,"},{"verseNumber":2,"verseKey":"96:2","text":"stvara čovjeka od zakvačka."},{"verseNumber":3,"verseKey":"96:3","text":"Čitaj, plemenit je Gospodar tvoj,"},{"verseNumber":4,"verseKey":"96:4","text":"Koji poučava peru,"},{"verseNumber":5,"verseKey":"96:5","text":"Koji čovjeka poučava onome što ne zna."},{"verseNumber":6,"verseKey":"96:6","text":"Uistinu čovjek se uzobijesti"},{"verseNumber":7,"verseKey":"96:7","text":"čim se neovisnim osjeti"},{"verseNumber":8,"verseKey":"96:8","text":"a Gospodaru tvome će se, doista, svi vratiti!"},{"verseNumber":9,"verseKey":"96:9","text":"Vidjeli ti onoga koji sprečava"},{"verseNumber":10,"verseKey":"96:10","text":"roba da klanja?"},{"verseNumber":11,"verseKey":"96:11","text":"Šta misliš, ako on je on na Pravom putu,"},{"verseNumber":12,"verseKey":"96:12","text":"ili ako bogobojaznost naređuje?!"},{"verseNumber":13,"verseKey":"96:13","text":"Šta misliš, ako on poriče i okreće se,"},{"verseNumber":14,"verseKey":"96:14","text":"zar on ne zna da Allah vidi?!"},{"verseNumber":15,"verseKey":"96:15","text":"Naprotiv! Ako se ne okani, ocrnit ćemo mu čelo,"},{"verseNumber":16,"verseKey":"96:16","text":"čelo lažno i grešno,"},{"verseNumber":17,"verseKey":"96:17","text":"pa neka on pozove društvo svoje."},{"verseNumber":18,"verseKey":"96:18","text":"Mi ćemo pozvati zebanije."},{"verseNumber":19,"verseKey":"96:19","text":"Naprotiv! Ti se njemu ne pokoravaj, već čini sedždu i približi se Gospodaru svome!"}]}