{"id":105,"slug":"barwani-sw","resourceId":49,"nameNative":"Ali Muhsin Al-Barwani (Kiswahili)","nameAr":"البرواني","nameEn":"Ali Muhsin Al-Barwani","lang":"sw","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"105:1","text":"Kwani hukuona jinsi Mola wako Mlezi alivyo watenda wale wenye tembo?"},{"verseNumber":2,"verseKey":"105:2","text":"Kwani hakujaalia vitimbi vyao kuharibika?"},{"verseNumber":3,"verseKey":"105:3","text":"Na akawapelekea ndege makundi kwa makundi,"},{"verseNumber":4,"verseKey":"105:4","text":"Wakiwatupia mawe ya udongo wa Motoni,"},{"verseNumber":5,"verseKey":"105:5","text":"Akawafanya kama majani yaliyo liwa!"}]}