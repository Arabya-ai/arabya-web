      "id": "TW:mutanabbi-samples:2",
      "titleAr": "إذا غامرت",
      "titleEn": "If you venture",
      "textAr": "إِذَا غَامَرْتَ فِي شَرَفٍ مَرُومِ · فَلا تَقْنَعْ بِمَا دُونَ النُّجُومِ",
      "meter": "الوافر"
    },
    {
      "id": "TW:mutanabbi-samples:3",
      "titleAr": "الخيل والليل",
      "titleEn": "Horses and night",
      "textAr": "الخَيْلُ وَاللَّيْلُ وَالبَيْدَاءُ تَعْرِفُنِي · وَالسَّيْفُ وَالرُّمْحُ وَالقِرْطَاسُ وَالقَلَمُ",
      "meter": "البسيط"
    }
  ]
