{"id":111,"slug":"ma-jain-zh","resourceId":56,"nameNative":"马坚译（中文）","nameAr":"ما جيان","nameEn":"Chinese Translation (Ma Jian)","lang":"zh","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"111:1","text":"愿焰父两手受伤！他必定受伤,"},{"verseNumber":2,"verseKey":"111:2","text":"他的财产, 和他所获得的, 将无裨于他,"},{"verseNumber":3,"verseKey":"111:3","text":"他将入有焰的烈火,"},{"verseNumber":4,"verseKey":"111:4","text":"他的担柴的妻子, 也将入烈火,"},{"verseNumber":5,"verseKey":"111:5","text":"她的颈上系著一条坚实的绳子。"}]}