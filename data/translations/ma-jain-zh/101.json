{"id":101,"slug":"ma-jain-zh","resourceId":56,"nameNative":"马坚译（中文）","nameAr":"ما جيان","nameEn":"Chinese Translation (Ma Jian)","lang":"zh","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"101:1","text":"大难,"},{"verseNumber":2,"verseKey":"101:2","text":"大难是什么？"},{"verseNumber":3,"verseKey":"101:3","text":"你怎能知道大难是什么？"},{"verseNumber":4,"verseKey":"101:4","text":"在那日, 众人将似分散的飞蛾,"},{"verseNumber":5,"verseKey":"101:5","text":"山岳将似疏松的采绒。"},{"verseNumber":6,"verseKey":"101:6","text":"至於善功的份量较重者,"},{"verseNumber":7,"verseKey":"101:7","text":"将在满意的生活中;"},{"verseNumber":8,"verseKey":"101:8","text":"至於善功的份量较轻者,"},{"verseNumber":9,"verseKey":"101:9","text":"他的归宿是深坑。"},{"verseNumber":10,"verseKey":"101:10","text":"你怎能知道深坑里有什么？"},{"verseNumber":11,"verseKey":"101:11","text":"有烈火。"}]}