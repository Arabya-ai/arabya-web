# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# MPT stock-API keys written at runtime by Next (never commit)

# local acquisition staging (Internet Archive / owner drops)
/incoming/

# Owner uploads (runtime on Contabo)
/data/imported-books/
/data/imported-library/
/.cache/

# local user sync (Contabo SQLite)
data/user-data.sqlite
data/user-data.sqlite-wal
data/user-data.sqlite-shm

# لغوي runtime quota / encrypted BYOK keys
/.data/

# MoneyPrinterTurbo engine runtime (keep source; ignore secrets/output/media)

# Arabya NLP FastAPI (Contabo) — keep source; ignore local venv
services/arabya-nlp/.venv/
services/agent-lab/.venv/
services/arabya-nlp/venv/
services/arabya-nlp/*.sqlite
services/arabya-nlp/*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
__pycache__/
