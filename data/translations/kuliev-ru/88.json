{"id":88,"slug":"kuliev-ru","resourceId":45,"nameNative":"Эльмир Кулиев (Русский)","nameAr":"كولييف","nameEn":"Elmir Kuliev","lang":"ru","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"88:1","text":"Дошел ли до тебя рассказ о Покрывающем (Дне воскресения)?"},{"verseNumber":2,"verseKey":"88:2","text":"Одни лица в тот день будут унижены,"},{"verseNumber":3,"verseKey":"88:3","text":"изнурены и утомлены."},{"verseNumber":4,"verseKey":"88:4","text":"Они войдут в Огонь жаркий."},{"verseNumber":5,"verseKey":"88:5","text":"Их будут поить из источника кипящего"},{"verseNumber":6,"verseKey":"88:6","text":"и кормить только ядовитыми колючками,"},{"verseNumber":7,"verseKey":"88:7","text":"от которых не поправляются и которые не утоляют голода."},{"verseNumber":8,"verseKey":"88:8","text":"Другие же лица в тот день будут радостны."},{"verseNumber":9,"verseKey":"88:9","text":"Они будут довольны своими стараниями"},{"verseNumber":10,"verseKey":"88:10","text":"в Вышних садах."},{"verseNumber":11,"verseKey":"88:11","text":"Они не услышат там словоблудия."},{"verseNumber":12,"verseKey":"88:12","text":"Там есть источник текущий."},{"verseNumber":13,"verseKey":"88:13","text":"Там воздвигнуты ложа,"},{"verseNumber":14,"verseKey":"88:14","text":"расставлены чаши,"},{"verseNumber":15,"verseKey":"88:15","text":"разложены подушки,"},{"verseNumber":16,"verseKey":"88:16","text":"и разостланы ковры."},{"verseNumber":17,"verseKey":"88:17","text":"Неужели они не видят, как созданы верблюды,"},{"verseNumber":18,"verseKey":"88:18","text":"как вознесено небо,"},{"verseNumber":19,"verseKey":"88:19","text":"как водружены горы,"},{"verseNumber":20,"verseKey":"88:20","text":"как распростерта земля?"},{"verseNumber":21,"verseKey":"88:21","text":"Наставляй же, ведь ты - наставник,"},{"verseNumber":22,"verseKey":"88:22","text":"и ты не властен над ними."},{"verseNumber":23,"verseKey":"88:23","text":"А тех, кто отвернется и не уверует,"},{"verseNumber":24,"verseKey":"88:24","text":"Аллах подвергнет величайшим мучениям."},{"verseNumber":25,"verseKey":"88:25","text":"К Нам они вернутся,"},{"verseNumber":26,"verseKey":"88:26","text":"и затем Мы потребуем у них отчета."}]}