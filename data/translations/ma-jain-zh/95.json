{"id":95,"slug":"ma-jain-zh","resourceId":56,"nameNative":"马坚译（中文）","nameAr":"ما جيان","nameEn":"Chinese Translation (Ma Jian)","lang":"zh","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"95:1","text":"以无花果和橄榄果盟誓,"},{"verseNumber":2,"verseKey":"95:2","text":"以西奈山盟誓,"},{"verseNumber":3,"verseKey":"95:3","text":"以这个安宁的城市盟誓,"},{"verseNumber":4,"verseKey":"95:4","text":"我确已把人造成具有最美的形态,"},{"verseNumber":5,"verseKey":"95:5","text":"然后我使他变成最卑劣的;"},{"verseNumber":6,"verseKey":"95:6","text":"但信道而且行善者, 将受不断的报酬。"},{"verseNumber":7,"verseKey":"95:7","text":"此后, 你怎麽还否认报应呢？"},{"verseNumber":8,"verseKey":"95:8","text":"难道真主不是最公正的判决者吗？"}]}