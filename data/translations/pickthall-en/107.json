{"id":107,"slug":"pickthall-en","resourceId":19,"nameNative":"M. Pickthall (English)","nameAr":"بكثال","nameEn":"M. Pickthall","lang":"en","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"107:1","text":"Hast thou observed him who belieth religion?"},{"verseNumber":2,"verseKey":"107:2","text":"That is he who repelleth the orphan,"},{"verseNumber":3,"verseKey":"107:3","text":"And urgeth not the feeding of the needy."},{"verseNumber":4,"verseKey":"107:4","text":"Ah, woe unto worshippers"},{"verseNumber":5,"verseKey":"107:5","text":"Who are heedless of their prayer;"},{"verseNumber":6,"verseKey":"107:6","text":"Who would be seen (at worship)"},{"verseNumber":7,"verseKey":"107:7","text":"Yet refuse small kindnesses!"}]}