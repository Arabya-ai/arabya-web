{"id":100,"slug":"ma-jain-zh","resourceId":56,"nameNative":"马坚译（中文）","nameAr":"ما جيان","nameEn":"Chinese Translation (Ma Jian)","lang":"zh","source":"Quran.com API v4","sourceUrl":"https://quran.com","verses":[{"verseNumber":1,"verseKey":"100:1","text":"以喘息而奔驰的马队盟誓,"},{"verseNumber":2,"verseKey":"100:2","text":"以蹄发火花的马队盟誓,"},{"verseNumber":3,"verseKey":"100:3","text":"以早晨出击,"},{"verseNumber":4,"verseKey":"100:4","text":"卷起尘埃,"},{"verseNumber":5,"verseKey":"100:5","text":"攻入敌围的马队盟誓,"},{"verseNumber":6,"verseKey":"100:6","text":"人对于主, 确是孤负的。"},{"verseNumber":7,"verseKey":"100:7","text":"他自己对那孤负确是见证的,"},{"verseNumber":8,"verseKey":"100:8","text":"他对于财产确是酷好的。"},{"verseNumber":9,"verseKey":"100:9","text":"难道他不知道吗？当坟中的朽骨被揭发,"},{"verseNumber":10,"verseKey":"100:10","text":"胸中的秘密被显示的时侯,"},{"verseNumber":11,"verseKey":"100:11","text":"在那日, 他们的主, 确是彻知他们的。"}]}